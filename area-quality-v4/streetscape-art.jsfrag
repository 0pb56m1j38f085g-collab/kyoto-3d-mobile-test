   const foot=Math.min(...corners.map(p=>storyGround(p[0],p[2]))),plinth=Math.max(.13,y-foot+.13);
   const rim=[[-w*.52,-d*.525],[w*.52,-d*.525],[w*.52,d*.525],[-w*.52,d*.525]];
   for(let j=0;j<4;j++){const a=P(rim[j][0],.025,rim[j][1]),b=P(rim[(j+1)%4][0],.025,rim[(j+1)%4][1]);houseFootings.quad(a,b,[b[0],Math.min(b[1]-.025,storyGround(b[0],b[2])-.035),b[2]],[a[0],Math.min(a[1]-.025,storyGround(a[0],a[2])-.035),a[2]]);}
