   const plaster=['#d9bd8e','#e1c9a6','#bb9879','#d3bca0','#d4ccb1','#cbb89e'][kind],tile=['#454a50','#55585b','#626069','#4d5357','#464e56','#58595e'][kind],wood=['#68472e','#835b38','#765033'][kind%3];
   const P=(xx,yy,zz)=>[x+co*xx+si*zz,y+yy,z-si*xx+co*zz];
