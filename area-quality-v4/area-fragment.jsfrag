  plate([x,y+.72,z],[.13,.42,.085],'#d7c6a5',a,1);
 }
 // Two water basins anchor temple approaches without blocking the sightline.
 for(const [x,z,a]of[[areaAnchor.kodaiji[0]-3.0,areaAnchor.kodaiji[1]+1.2,.05],[yasakaX+3.1,yasakaZ-4.7,0]]){
  const y=ground(x,z);
  box([x,y+.23,z],[.72,.38,.48],'#aaa697',a,3);
  plate([x,y+.43,z],[.58,.08,.34],'#89aeb0',a,5);
  pole([x-.37,y+.22,z],[x-.37,y+.77,z],.032,'#78604b');
  beam([x-.37,y+.72,z],[x+.10,y+.72,z],.025,'#87684f');
 }
 // Discreet benches and planter pots add small-scale depth at open pockets.
 for(const [x,z,a]of[[4.5,24.8,.24],[8.0,34.5,-.10],[-30.8,36.9,.04],[-18.4,31.8,.06]]){
  const y=ground(x,z);
  plate([x,y+.28,z],[.92,.10,.34],'#9f7958',a,1);
  for(const side of[-1,1])box([x+Math.cos(a)*side*.34,y+.12,z-Math.sin(a)*side*.34],[.10,.28,.20],'#765640',a,1);
  const px=x+Math.cos(a)*.66,pz=z-Math.sin(a)*.66,py=ground(px,pz);
  box([px,py+.12,pz],[.26,.22,.26],'#92715b',a,1);
  ball([px,py+.34,pz],[.23,.24,.23],pick(C.greens),tiny,4);
 }

  // Reject intersecting infill using all street segments, including lanes authored later.
 for(const args of houseQueue){
  const[x,z,a=0,s=1]=args,radius=1.04*s;
  if(x>-44-radius&&x<-24+radius&&z>15-radius&&z<52+radius)continue;
  if(areaRoads.some(r=>r.pts.some((p,i)=>i&&dseg(x,z,r.pts[i-1],p)<r.width*.5+.75*s)))continue;
  if(placedHouses.some(p=>Math.hypot(x-p.x,z-p.z)<radius+p.radius))continue;
  if(Math.abs(x-yasakaX)<5.8&&z>yasakaZ-12.5&&z<yasakaZ+3.7)continue;
  drawMachiya(...args);placedHouses.push({x,z,yaw:a,scale:s,radius});
 }
 scene.areaStreets=areaRoads;scene.areaSites.roadReference={source:'OpenStreetMap contributors',license:'ODbL 1.0',wayIds:historicalStreets.map(r=>r.id)};
 scene.areaBuildings=placedHouses;
 scene.areaSites.placementAccuracy='Geographic landmark anchors. Landmark silhouettes reference official inventories; selected historic streets follow OSM ways; gardens, remaining streets and intermediate houses remain authored, not measured footprints.';
