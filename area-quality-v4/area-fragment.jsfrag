// --- Higashiyama / Gion area quality pass v2 ---------------------------------
 // Geographic anchors are derived from published coordinates, scaled for this
 // miniature at roughly 20 metres per scene unit. Roads and intermediate
 // footprints remain authored until GIS ingestion; landmark geometry is custom.
 group='higashiyama-area';
 // Smaller roofs retain curved profiles and physical fascia without using the main hall's
 // 13,000-triangle roof on every lantern. Local vertices permit correct roof rotation.
 function areaHip(name,cx,cz,w,d,y,h,ridge=.30,color='#736d66',yaw=0){
  const roof=mesh(name),edge=mesh(name+'-edge'),nu=Math.max(8,Math.min(24,Math.ceil(w*3))),nt=Math.max(5,Math.min(14,Math.ceil(d*2)));
  const P=(u,t,side)=>{
   const xx=side<2?u*w*(ridge*(1-t)+.5*t):(side===2?1:-1)*w*(ridge*(1-t)+.5*t);
   const zz=side<2?(side===0?1:-1)*d*.5*t:u*d*.5*t;
   return[xx,h*(1-t)+h*.10*Math.sin(t*Math.PI)-h*.10*Math.sin(t*Math.PI*.5)+h*.08*t**8+h*.08*Math.abs(u)**7*t**5,zz];
  };
  const NN=(u,t,k)=>{let n=V.unit(V.cross(V.sub(P(u+.0001,t,k),P(u-.0001,t,k)),V.sub(P(u,t+.0001,k),P(u,t-.0001,k))));return n[1]<0?V.mul(n,-1):n;};
  for(let k=0;k<4;k++)for(let i=0;i<nu;i++)for(let j=0;j<nt;j++){
   const u=-1+2*i/nu,v=u+2/nu,t=j/nt,tt=(j+1)/nt;
   roof.tri(P(u,t,k),P(v,t,k),P(v,tt,k),NN(u,t,k),NN(v,t,k),NN(v,tt,k),[u*w,t*d],[v*w,t*d],[v*w,tt*d]);
   roof.tri(P(u,t,k),P(v,tt,k),P(u,tt,k),NN(u,t,k),NN(v,tt,k),NN(u,tt,k),[u*w,t*d],[v*w,tt*d],[u*w,tt*d]);
  }
  for(let k=0;k<4;k++)for(let i=0;i<nu;i++){
   const a=P(-1+2*i/nu,1,k),b=P(-1+2*(i+1)/nu,1,k),th=Math.min(.10,h*.14);
   edge.quad(a,b,[b[0],b[1]-th,b[2]],[a[0],a[1]-th,a[2]]);
  }
  I(roof,[cx,y,cz],[1,1,1],color,Q.y(yaw),2);I(edge,[cx,y,cz],[1,1,1],'#514c45',Q.y(yaw),2);
  const T=p=>[cx+Math.cos(yaw)*p[0]+Math.sin(yaw)*p[2],y+p[1],cz-Math.sin(yaw)*p[0]+Math.cos(yaw)*p[2]];
  if(ridge>0)beam(T([-w*ridge,h+.02,0]),T([w*ridge,h+.02,0]),Math.min(.08,w*.04),'#6d6d65',Math.min(.13,d*.06));
  if(w>2)for(const side of[0,1])for(const u of[-1,1])for(let k=0;k<7;k++){
   const a=P(u,k/7,side),b=P(u,(k+1)/7,side);a[1]+=.018;b[1]+=.018;beam(T(a),T(b),.025,'#878578');
  }
 }

 const areaAnchor={kiyomizu:[0,-3],hokanji:[-26.22,16.62],kodaiji:[-17.72,28.84],yasaka:[-29.14,44.59]};
 scene.areaSites={
  scaleMetresPerUnit:20,
  geographicAnchors:{
   kiyomizu:{lat:34.99500,lon:135.78500,local:areaAnchor.kiyomizu},
   hokanji:{lat:34.99855,lon:135.77925,local:areaAnchor.hokanji},
   kodaiji:{lat:35.0007611,lon:135.7811139,local:areaAnchor.kodaiji},
   yasaka:{lat:35.00361,lon:135.77861,local:areaAnchor.yasaka}
  },
  placementAccuracy:'anchor-based landmarks; authored intermediate streets/buildings'
 };
 // The Kiyomizu study originally planted woodland across the full art board.
 // Remove only those pre-existing landscape instances that fall inside the new
 // urban extension, then rebuild the greenery as controlled precinct edges.
 const urbanContains=(x,z)=>x<-6.5&&x>-38&&z>6&&z<53;
 for(const m of scene.meshes)m.instances=m.instances.filter(i=>!(i.group==='landscape'&&urbanContains(i.p[0],i.p[2])));
 // Extend the authored terrain north of the original Kiyomizu study so Yasaka and the Gion edge sit on continuous ground.
 const northTerrain=mesh('higashiyama-north-terrain-extension');
 const NT=(i,j)=>{const x=-62+i*.65,z=37.35+j*.65;return[x,ground(x,z),z];};
 for(let i=0;i<126;i++)for(let j=0;j<39;j++){
  const a=NT(i,j),b=NT(i+1,j),c=NT(i+1,j+1),d=NT(i,j+1);
  northTerrain.tri(a,d,c,N(a),N(d),N(c));northTerrain.tri(a,c,b,N(a),N(c),N(b));
 }
 group='district-terrain';I(northTerrain,[0,0,0],[1,1,1],'#9cab76',undefined,0);group='higashiyama-area';
 // Northern park edge keeps the expanded ground visually connected to the wooded Higashiyama slope.
 for(let j=0;j<72;j++){
  const a=j*2.399,rad=3.0+Math.sqrt((j+.4)/72)*12.0,x=-19+Math.cos(a)*rad,z=51+Math.sin(a)*rad*.55;
  if(x<-39||x>2||z<39||z>61)continue;
  if(Math.hypot(x-areaAnchor.yasaka[0],z-areaAnchor.yasaka[1])<10.5)continue;
  const sz=range(.62,1.12);
  if(rnd()<.16)pine(x,z,sz*.80);else tree(x,z,sz,rnd()<.23?'pink':rnd()<.08?'cream':'green',1);
 }

 const dseg=(x,z,a,b)=>{const dx=b[0]-a[0],dz=b[1]-a[1],q=dx*dx+dz*dz,t=q?clamp(((x-a[0])*dx+(z-a[1])*dz)/q,0,1):0;return Math.hypot(x-a[0]-dx*t,z-a[1]-dz*t);};
 const landmarkClear=(x,z)=>Math.hypot(x-areaAnchor.hokanji[0],z-areaAnchor.hokanji[1])<4.4||Math.hypot(x-areaAnchor.kodaiji[0],z-areaAnchor.kodaiji[1])<7.1||Math.hypot(x-areaAnchor.yasaka[0],z-areaAnchor.yasaka[1])<9.4;
 const areaRoads=[];
 function areaRoad(name,pts,width=1.05,color='#d8ceb8',edge='#cbbda3'){
  areaRoads.push({name,pts,width});
  for(let n=0;n<pts.length-1;n++){
   const a=pts[n],b=pts[n+1],dx=b[0]-a[0],dz=b[1]-a[1],len=Math.hypot(dx,dz),steps=Math.max(1,Math.ceil(len/.72));
   for(let k=0;k<steps;k++){
    const t=(k+.5)/steps,x=a[0]+dx*t,z=a[1]+dz*t,ang=Math.atan2(dx,dz);
    plate([x,ground(x,z)+.052,z],[width+.22,.055,len/steps+.11],edge,ang,0);
    plate([x,ground(x,z)+.082,z],[width,.052,len/steps+.10],color,ang,0);
   }
  }
 }
 function areaStoneWall(a,b,h=.7){
  const dx=b[0]-a[0],dz=b[1]-a[1],len=Math.hypot(dx,dz),steps=Math.max(1,Math.ceil(len/.72)),ang=Math.atan2(dx,dz);
  for(let i=0;i<steps;i++){
   const t=(i+.5)/steps,x=a[0]+dx*t,z=a[1]+dz*t,y=ground(x,z);
   box([x,y+h*.46,z],[.70,h,.42],i%3===0?'#bbb7a7':i%3===1?'#c8c4b6':'#aaa89c',ang+(i%2?-.04:.04),3);
  }
 }
 function areaSteps(a,b,width=1.2,count=10){
  const dx=b[0]-a[0],dz=b[1]-a[1],ang=Math.atan2(dx,dz);
  for(let i=0;i<count;i++){
   const t=(i+.5)/count,x=a[0]+dx*t,z=a[1]+dz*t,y=ground(x,z);
   plate([x,y+.08,z],[width,.11,Math.hypot(dx,dz)/count+.09],'#d5c9b4',ang,3);
  }
 }
 const eastSpine=[[-1,6],[-5,9],[-10,11.5],[-15,13.5],[-20,15.2],areaAnchor.hokanji,[-23.4,22.2],[-20.6,25.5],areaAnchor.kodaiji,[-21.8,35.3],[-25.0,39.6],areaAnchor.yasaka];
 areaRoad('higashiyama-spine',eastSpine,1.20,'#e7dcc8');
 const historicalStreets=__HISTORIC_STREETS__;
 const gionLink=[areaAnchor.kodaiji,[-20.5,34],[-24.8,39],areaAnchor.yasaka];
 for(const r of historicalStreets){
  const width=r.highway==='steps'?.68:r.highway==='residential'?.95:.72;
  areaRoad('osm-'+r.id,r.points,width,'#dfd3bf');
  if(r.highway==='steps')for(let j=1;j<r.points.length;j++)areaSteps(r.points[j-1],r.points[j],width,Math.max(3,Math.round(Math.hypot(r.points[j][0]-r.points[j-1][0],r.points[j][1]-r.points[j-1][1])/.14)));
 }
 areaRoad('gion-link',gionLink,1.02,'#e4d7bd');

 let areaHouseId=0;
 const houseQueue=[],placedHouses=[];
 function areaMachiya(...args){houseQueue.push(args);}
 const machiyaRoof=mesh('district-shared-kirizuma-roof'),machiyaGable=mesh('district-shared-plaster-gable');
 for(const side of[-1,1]){
  for(let j=0;j<8;j++){
   const t=j/8,tt=(j+1)/8,P=(x,a)=>[x,.32*(1-a)+.025*Math.sin(a*Math.PI),side*.5*a];
   machiyaRoof.quad(P(-.5,t),P(.5,t),P(.5,tt),P(-.5,tt));
  }
  machiyaGable.tri([side*.5,0,-.5],[side*.5,.32,0],[side*.5,0,.5],[side,0,0]);
 }
 function drawMachiya(x,z,a=0,s=1,tone=0,variant=0){
  const y=ground(x,z),w=(1.62+variant*.11)*s,d=(1.75+(variant%2)*.30)*s,h=(1.12+(variant%3)*.09)*s;
  const plaster=['#d8cdb6','#d4bea0','#dfd4bf','#cbb89b'][tone%4],trim=['#665043','#775b47','#5b4c41'][tone%3],roof=['#727671','#7b7a70','#626b69','#827b6d'][variant%4];
  const T=(xx,yy,zz)=>[x+Math.cos(a)*xx+Math.sin(a)*zz,yy,z-Math.sin(a)*xx+Math.cos(a)*zz];
  const B=(xx,yy,zz,sz,c)=>plate(T(xx,yy,zz),sz,c,a,1);
  box([x,y+h*.50,z],[w,h,d],plaster,a,1);
  B(0,y+h*.23,0,[w+.025,h*.46,d+.025],trim);
  I(machiyaRoof,[x,y+h,z],[w*1.14,s,d*1.12],roof,Q.y(a),2);
  I(machiyaGable,[x,y+h,z],[w,s,d],plaster,Q.y(a),1);
  B(0,y+h+.33*s,0,[w*1.17,.055*s,.085*s],'#666c65');
  for(const side of[-1,1])B(0,y+h-.035*s,side*d*.57,[w*1.17,.075*s,.075*s],trim);
  // Hirairi frontage: recessed lattice at ground level, small mushikomado above,
  // and a shallow first-floor eave. Every part uses the same orientation.
  B(0,y+.36*s,d*.509,[w*.83,.58*s,.035*s],'#433e33');
  for(let j=-5;j<=5;j++)B(j*w*.075,y+.36*s,d*.532,[.023*s,.58*s,.028*s],trim);
  B(0,y+.20*s,d*.55,[w*.88,.028*s,.035*s],'#967858');
  B(0,y+.53*s,d*.55,[w*.88,.028*s,.035*s],'#967858');
  for(const side of[-1,1]){
   B(side*w*.23,y+h*.80,d*.511,[w*.29,.23*s,.035*s],'#5c5648');
   for(let j=-1;j<=1;j++)B(side*w*.23+j*.075*s,y+h*.80,d*.54,[.028*s,.23*s,.035*s],plaster);
  }
  const eave=plate(T(0,y+.69*s,d*.60),[w*1.10,.065*s,.47*s],roof,a,2);
  eave.q=Q.mul?Q.mul(Q.y(a),Q.axis([1,0,0],.15)):Q.y(a);
  for(const side of[-1,1])B(side*w*.46,y+.35*s,d*.54,[.06*s,.7*s,.06*s],trim);
  if(variant%2===0)for(let j=0;j<3;j++)B((j-1)*.16*s,y+.49*s,d*.77,[.15*s,.24*s,.025*s],tone%2?'#5e7e78':'#ad7768');
  B(0,y+.035,d*.65,[w*.80,.06,.28*s],'#bab6a7');
  const pot=T(w*.51,y+.12,d*.57);box(pot,[.20*s,.22*s,.20*s],'#9a7d60',a,3);
  const crown=T(w*.51,y+.32,d*.57);ball(crown,[.17*s,.22*s,.17*s],pick(C.greens),tiny,4);
  areaHouseId++;
 }
 function ribbonBuildings(pts,spacing=2.25){
  for(let n=0;n<pts.length-1;n++){
   const a=pts[n],b=pts[n+1],dx=b[0]-a[0],dz=b[1]-a[1],len=Math.hypot(dx,dz),ang=Math.atan2(dx,dz),nx=-dz/len,nz=dx/len;
   const count=Math.max(1,Math.floor(len/spacing));
   for(let k=0;k<count;k++){
    const t=(k+.55)/count,cx=a[0]+dx*t,cz=a[1]+dz*t;
    for(const side of[-1,1]){
     if(rnd()<.11)continue;
     const off=2.02+range(.08,.62),x=cx+nx*off*side,z=cz+nz*off*side;
     if(Math.hypot(x-areaAnchor.hokanji[0],z-areaAnchor.hokanji[1])<3.5||Math.hypot(x-areaAnchor.kodaiji[0],z-areaAnchor.kodaiji[1])<4.2||Math.hypot(x-areaAnchor.yasaka[0],z-areaAnchor.yasaka[1])<5.0)continue;
     areaMachiya(x,z,ang+side*Math.PI/2+range(-.025,.025),range(.82,1.20),n+k+(side>0?1:0),(n*3+k+(side>0?2:0))%4);
    }
   }
  }
 }
 ribbonBuildings(eastSpine,2.28);for(const r of historicalStreets)ribbonBuildings(r.points,2.0);ribbonBuildings(gionLink,2.15);
 // Secondary lanes close the gaps between the four anchors so the area reads as one townscape.
 const hokanjiLane=[[areaAnchor.hokanji[0]-7.4,areaAnchor.hokanji[1]+1.2],[areaAnchor.hokanji[0]-3.7,areaAnchor.hokanji[1]+.4],areaAnchor.hokanji,[areaAnchor.hokanji[0]+4.8,areaAnchor.hokanji[1]-1.0]];
 const kodaijiLane=[[areaAnchor.kodaiji[0]-7.0,areaAnchor.kodaiji[1]+1.8],[areaAnchor.kodaiji[0]-3.2,areaAnchor.kodaiji[1]+.5],[areaAnchor.kodaiji[0]+5.7,areaAnchor.kodaiji[1]-.7]];
 const yasakaLane=[[areaAnchor.yasaka[0]-7.0,areaAnchor.yasaka[1]-4.8],[areaAnchor.yasaka[0]-3.5,areaAnchor.yasaka[1]-3.6],[areaAnchor.yasaka[0]+5.8,areaAnchor.yasaka[1]-4.0]];
 for(const [name,pts,w]of[['hokanji-side-lane',hokanjiLane,.78],['kodaiji-side-lane',kodaijiLane,.82],['yasaka-south-lane',yasakaLane,.95]]){areaRoad(name,pts,w,'#ded2bc');ribbonBuildings(pts,1.90);}
 // Small cross lanes make the streetscape a fabric rather than a single ribbon.
 const crossLanes=[[[-12.5,17.6],[-18.6,19.0]],[[-20.0,24.0],[-14.5,25.3]],[[-24.0,33.5],[-17.5,34.8]],[[-32.0,40.4],[-24.0,41.0]]];
 for(let q=0;q<crossLanes.length;q++){areaRoad('cross-lane-'+q,crossLanes[q],.68,'#e0d5bf');ribbonBuildings(crossLanes[q],2.05);}

 function hokanjiPagoda(x,z,s=1){
  const y=ground(x,z),wood='#8d765a',deep='#5b4938',roof='#625f59';
  for(let k=0;k<5;k++){
   const bodyW=(2.45-k*.18)*s,levelY=y+.54*s+k*.94*s;
   box([x,levelY,z],[bodyW*.58,.82*s,bodyW*.58],wood,0,1);
   // corner posts and balustrade
   for(const sx of[-1,1])for(const sz of[-1,1])pole([x+sx*bodyW*.31,levelY-.33*s,z+sz*bodyW*.31],[x+sx*bodyW*.31,levelY+.34*s,z+sz*bodyW*.31],.045*s,deep);
   // Three-bay elevations, open shadowed shutters, stacked bracket arms and balustrades.
   for(const side of[-1,1])for(let j=-1;j<=1;j++){
    const u=j*bodyW*.20;
    plate([x+u,levelY,z+side*bodyW*.298],[bodyW*.16,.43*s,.025*s],'#4d4436',0,1);
    plate([x+side*bodyW*.298,levelY,z+u],[.025*s,.43*s,bodyW*.16],'#4d4436',0,1);
    for(let q=0;q<3;q++){
     box([x+u,levelY+(.27+q*.055)*s,z+side*bodyW*.31],[.13*s,.05*s,(.18+q*.08)*s],'#a28a67',0,1);
     box([x+side*bodyW*.31,levelY+(.27+q*.055)*s,z+u],[(.18+q*.08)*s,.05*s,.13*s],'#a28a67',0,1);
    }
   }
   for(const side of[-1,1])for(let j=-3;j<=3;j++){
    const u=j*bodyW*.12,yy=levelY+.19*s;
    pole([x+u,yy,z+side*bodyW*.42],[x+u,yy+.16*s,z+side*bodyW*.42],.018*s,deep);
    pole([x+side*bodyW*.42,yy,z+u],[x+side*bodyW*.42,yy+.16*s,z+u],.018*s,deep);
   }
   areaHip('hokanji-roof-'+k,x,z,bodyW*1.26,bodyW*1.26,levelY+.35*s,.40*s,.24,roof);
   plate([x,levelY+.18*s,z],[bodyW*.88,.06*s,bodyW*.88],'#b08863',0,1);
  }
  pole([x,y+5.08*s,z],[x,y+6.12*s,z],.05*s,'#927246');
  for(let k=0;k<9;k++)ball([x,y+(5.32+k*.105)*s,z],[.14*s,.025*s,.14*s],'#8a7860',tiny,1);
  ball([x,y+6.28*s,z],[.09*s,.14*s,.09*s],'#a48e67',tiny,1);
  areaStoneWall([x-2.4*s,z-2.1*s],[x+2.3*s,z-2.1*s],.48*s);
 }
 group='legacy-hokanji';
 hokanjiPagoda(areaAnchor.hokanji[0],areaAnchor.hokanji[1],1.06);
 group='higashiyama-area';

 function templeCompound(x,z,s=1){
  const y=ground(x,z),wood='#966b4d',roof='#72645c';
  // main hall
  box([x,y+.68*s,z],[4.6*s,1.36*s,2.95*s],wood,0,1);
  areaHip('kodaiji-main-roof',x,z,5.4*s,3.7*s,y+1.30*s,1.10*s,.30,roof);
  // front veranda and columns
  plate([x,y+.18*s,z+1.75*s],[5.0*s,.18*s,1.2*s],'#b58f65',0,1);
  for(let i=-3;i<=3;i++)pole([x+i*.65*s,y+.20*s,z+1.60*s],[x+i*.65*s,y+1.35*s,z+1.60*s],.05*s,'#76513b');
  // Five front bays with recessed light plaster and dark lattice under the eaves.
  for(let i=-2;i<=2;i++){
   const px=x+i*.82*s;
   plate([px,y+.82*s,z+1.49*s],[.68*s,.88*s,.055*s],i===0?'#d8ccb4':'#e6dcc6',0,1);
   for(let j=-1;j<=1;j++)plate([px+j*.19*s,y+.82*s,z+1.455*s],[.025*s,.86*s,.035*s],'#674a37',0,1);
   plate([px,y+.57*s,z+1.43*s],[.66*s,.025*s,.04*s],'#76523a',0,1);
  }
  // Veranda rail, bracket blocks and small stone lanterns make the hall readable up close.
  for(let i=-4;i<=4;i++){
   const px=x+i*.55*s;
   pole([px,y+.22*s,z+2.05*s],[px,y+.66*s,z+2.05*s],.028*s,'#76513b');
  }
  beam([x-2.35*s,y+.66*s,z+2.05*s],[x+2.35*s,y+.66*s,z+2.05*s],.035*s,'#8b6448');
  for(const side of[-1,1]){
   const lx=x+side*2.9*s,lz=z+2.25*s,ly=ground(lx,lz);
   pole([lx,ly,lz],[lx,ly+.55*s,lz],.035*s,'#858172');
   box([lx,ly+.66*s,lz],[.26*s,.22*s,.26*s],'#b9b4a5',0,3);
   areaHip('kodaiji-lantern-'+side,lx,lz,.38*s,.38*s,ly+.78*s,.15*s,.18,'#8a8578');
  }
  // smaller side hall
  const sx=x+4.2*s,sz=z-.6*s,sy=ground(sx,sz);
  box([sx,sy+.50*s,sz],[2.5*s,1.0*s,1.85*s],'#a27857',-.08,1);
  areaHip('kodaiji-side-roof',sx,sz,3.0*s,2.35*s,sy+.95*s,.72*s,.28,'#75655d');
  // Stone garden terrace and pond. A broad pale courtyard gives the precinct visual breathing room.
  plate([x,y+.08*s,z+3.0*s],[8.8*s,.06*s,3.6*s],'#d8cfbd',0,0);
  areaStoneWall([x-4.4*s,z+2.70*s],[x+5.4*s,z+2.70*s],.50*s);
  areaStoneWall([x-4.4*s,z-2.35*s],[x+1.8*s,z-2.35*s],.42*s);
  // Organic pond surface is added in the precinct finish.
  for(let r=0;r<10;r++){const aa=r*2.399,rr=(.65+(.08*r))*s,rx=x-1.3*s+Math.cos(aa)*rr,rz=z+3.1*s+Math.sin(aa)*rr,ry=ground(rx,rz);box([rx,ry+.08*s,rz],[.28*s,.16*s,.20*s],r%2?'#bdb7a7':'#aaa698',aa,3);}
  for(let j=0;j<16;j++){
   const a=j*2.399,rr=1.1*s*Math.sqrt((j+.4)/16),px=x+3.2*s+Math.cos(a)*rr,pz=z+1.2*s+Math.sin(a)*rr,py=ground(px,pz);
   ball([px,py+.18*s,pz],[.22*s,.16*s,.22*s],pick(C.greens),tiny,4);
  }
 }
 group='legacy-kodaiji';
 templeCompound(areaAnchor.kodaiji[0],areaAnchor.kodaiji[1],1.02);

 // Kodaiji precinct: white gravel garden, stepping stones, covered link and pond bridge.
 {
  const x=areaAnchor.kodaiji[0],z=areaAnchor.kodaiji[1],y=ground(x,z);
