   const a=pts[n],b=pts[n+1],dx=b[0]-a[0],dz=b[1]-a[1],len=Math.hypot(dx,dz),count=Math.max(1,Math.floor(len/4.2));
   for(let j=0;j<count;j++){const t=(j+.5)/count,x=a[0]+dx*t+range(-.24,.24),z=a[1]+dz*t+range(-.22,.22);person(x,ground(x,z)+.08,z,range(.44,.56),Math.atan2(dx,dz)+range(-.35,.35));}
  }
 }


 // Fine-grain street furniture for close mobile views. These are illustrative Kyoto-like details,
 // not an inventory of actual signs, lanterns or fences at surveyed coordinates.
 function streetLantern(x,z,a=0,scale=1){
  const y=ground(x,z);
  pole([x,y+.02,z],[x,y+.92*scale,z],.028*scale,'#735945');
  box([x,y+1.01*scale,z],[.20*scale,.28*scale,.20*scale],'#ead8b3',a,1);
  areaHip('street-lantern-cap-'+areaHouseId++,x,z,.32*scale,.32*scale,y+1.13*scale,.12*scale,.18,'#6f635b');
 }
 function lowFence(a,b,side=1){
  const dx=b[0]-a[0],dz=b[1]-a[1],len=Math.hypot(dx,dz),nx=-dz/len,nz=dx/len,steps=Math.max(2,Math.floor(len/.75));
  const yy=[];
  for(let j=0;j<=steps;j++){
   const t=j/steps,x=a[0]+dx*t+nx*.68*side,z=a[1]+dz*t+nz*.68*side,y=ground(x,z);
   pole([x,y+.02,z],[x,y+.48,z],.025,'#80654d');yy.push([x,y+.42,z]);
  }
  for(let j=0;j<yy.length-1;j++)beam(yy[j],yy[j+1],.023,'#94765a');
 }
 // Lantern rhythm follows only selected portions of the authored street spine.
 for(let n=1;n<eastSpine.length-1;n+=2){
  const a=eastSpine[n],b=eastSpine[n+1],dx=b[0]-a[0],dz=b[1]-a[1],len=Math.hypot(dx,dz),nx=-dz/len,nz=dx/len;
  const x=a[0]+dx*.48+nx*1.18,z=a[1]+dz*.48+nz*1.18;
  if(!landmarkClear(x,z))streetLantern(x,z,Math.atan2(dx,dz),.92);
 }
 for(const [a,b,side]of[
  [[-8.5,14.8],[-14.8,17.8],-1],
  [[-22.8,21.0],[-21.2,25.0],1],
  [[-19.5,32.0],[-22.8,36.7],-1],
  [[2.0,28.0],[7.5,31.0],1]
 ])lowFence(a,b,side);
 // Small wooden vertical shop signs sit beside a limited number of machiya.
 for(const [x,z,a]of[[-15.1,15.1,.25],[-21.7,20.0,.05],[-24.9,24.0,-.10],[-33.8,32.1,.02],[-35.4,38.1,-.03],[6.2,26.4,.28],[9.4,31.1,.18]]){
  const y=ground(x,z);
