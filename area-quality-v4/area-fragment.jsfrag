// --- Higashiyama / Gion area quality pass v2 ---------------------------------
 // Geographic anchors are derived from published coordinates, scaled for this
 // miniature at roughly 20 metres per scene unit. Roads and intermediate
 // footprints remain authored until GIS ingestion; landmark geometry is custom.
 group='higashiyama-area';
 const areaAnchor={kiyomizu:[0,-3],hokanji:[-26.22,16.62],kodaiji:[-17.72,28.84],yasaka:[-29.14,44.59]};
 scene.areaSites={
  scaleMetresPerUnit:20,
  geographicAnchors:{
   kiyomizu:{lat:34.99500,lon:135.78500,local:areaAnchor.kiyomizu},
   hokanji:{lat:34.99855,lon:135.77925,local:areaAnchor.hokanji},
   kodaiji:{lat:35.0007611,lon:135.7811139,local:areaAnchor.kodaiji},
   yasaka:{lat:35.00361,lon:135.77861,local:areaAnchor.yasaka}
  },
  placementAccuracy:'anchor-based landmarks; authored intermediate streets/buildings'
 };
 // The Kiyomizu study originally planted woodland across the full art board.
 // Remove only those pre-existing landscape instances that fall inside the new
 // urban extension, then rebuild the greenery as controlled precinct edges.
 const urbanContains=(x,z)=>x<-6.5&&x>-38&&z>6&&z<53;
 for(const m of scene.meshes)m.instances=m.instances.filter(i=>!(i.group==='landscape'&&urbanContains(i.p[0],i.p[2])));
 // Extend the authored terrain north of the original Kiyomizu study so Yasaka and the Gion edge sit on continuous ground.
 const northTerrain=mesh('higashiyama-north-terrain-extension');
 const NT=(i,j)=>{const x=-62+i*.65,z=37.35+j*.65;return[x,ground(x,z),z];};
 for(let i=0;i<126;i++)for(let j=0;j<39;j++){
  const a=NT(i,j),b=NT(i+1,j),c=NT(i+1,j+1),d=NT(i,j+1);
  northTerrain.tri(a,d,c,N(a),N(d),N(c));northTerrain.tri(a,c,b,N(a),N(c),N(b));
 }
 I(northTerrain,[0,0,0],[1,1,1],'#9cab76',undefined,0);
 // Northern park edge keeps the expanded ground visually connected to the wooded Higashiyama slope.
 for(let j=0;j<72;j++){
  const a=j*2.399,rad=3.0+Math.sqrt((j+.4)/72)*12.0,x=-19+Math.cos(a)*rad,z=51+Math.sin(a)*rad*.55;
  if(x<-39||x>2||z<39||z>61)continue;
  const sz=range(.62,1.12);
  if(rnd()<.16)pine(x,z,sz*.80);else tree(x,z,sz,rnd()<.23?'pink':rnd()<.08?'cream':'green',1);
 }

 const dseg=(x,z,a,b)=>{const dx=b[0]-a[0],dz=b[1]-a[1],q=dx*dx+dz*dz,t=q?clamp(((x-a[0])*dx+(z-a[1])*dz)/q,0,1):0;return Math.hypot(x-a[0]-dx*t,z-a[1]-dz*t);};
 const landmarkClear=(x,z)=>Math.hypot(x-areaAnchor.hokanji[0],z-areaAnchor.hokanji[1])<4.4||Math.hypot(x-areaAnchor.kodaiji[0],z-areaAnchor.kodaiji[1])<7.1||Math.hypot(x-areaAnchor.yasaka[0],z-areaAnchor.yasaka[1])<7.6;
 function areaRoad(name,pts,width=1.05,color='#d8ceb8',edge='#cbbda3'){
  for(let n=0;n<pts.length-1;n++){
   const a=pts[n],b=pts[n+1],dx=b[0]-a[0],dz=b[1]-a[1],len=Math.hypot(dx,dz),steps=Math.max(1,Math.ceil(len/.72));
   for(let k=0;k<steps;k++){
    const t=(k+.5)/steps,x=a[0]+dx*t,z=a[1]+dz*t,ang=Math.atan2(dx,dz);
    plate([x,ground(x,z)+.052,z],[width+.22,.055,len/steps+.11],edge,ang,0);
    plate([x,ground(x,z)+.082,z],[width,.052,len/steps+.10],color,ang,0);
   }
  }
 }
 function areaStoneWall(a,b,h=.7){
  const dx=b[0]-a[0],dz=b[1]-a[1],len=Math.hypot(dx,dz),steps=Math.max(1,Math.ceil(len/.72)),ang=Math.atan2(dx,dz);
  for(let i=0;i<steps;i++){
   const t=(i+.5)/steps,x=a[0]+dx*t,z=a[1]+dz*t,y=ground(x,z);
   box([x,y+h*.46,z],[.70,h,.42],i%3===0?'#bbb7a7':i%3===1?'#c8c4b6':'#aaa89c',ang+(i%2?-.04:.04),3);
  }
 }
 function areaSteps(a,b,width=1.2,count=10){
  const dx=b[0]-a[0],dz=b[1]-a[1],ang=Math.atan2(dx,dz);
  for(let i=0;i<count;i++){
   const t=(i+.5)/count,x=a[0]+dx*t,z=a[1]+dz*t,y=ground(x,z);
   plate([x,y+.08,z],[width,.11,Math.hypot(dx,dz)/count+.09],'#d5c9b4',ang,3);
  }
 }
 const eastSpine=[[-1,6],[-5,9],[-10,11.5],[-15,13.5],[-20,15.2],areaAnchor.hokanji,[-23.4,22.2],[-20.6,25.5],areaAnchor.kodaiji,[-21.8,35.3],[-25.0,39.6],areaAnchor.yasaka];
 areaRoad('higashiyama-spine',eastSpine,1.20,'#e7dcc8');
 const sannenzaka=[[-5,8.8],[-9,14],[-15.2,18.2],[-20.6,18.5]];
 const ninenzaka=[[-20.6,18.5],[-21.7,22.5],[-20.8,26.8],[-18.0,28.7]];
 const gionLink=[areaAnchor.kodaiji,[-20.5,34],[-24.8,39],areaAnchor.yasaka];
 areaRoad('sannenzaka',sannenzaka,.84,'#dfd1b8');areaRoad('ninenzaka',ninenzaka,.88,'#e2d4ba');areaRoad('gion-link',gionLink,1.08,'#e4d7bd');
 areaSteps([-12.2,15.3],[-15.8,18.4],1.05,11);areaSteps([-20.2,19.3],[-21.5,22.0],1.0,9);
 areaStoneWall([-13.0,12.5],[-20.7,15.1],.55);areaStoneWall([-20.2,23.0],[-18.8,28.0],.62);

 let areaHouseId=0;
 function areaMachiya(x,z,a=0,s=1,tone=0,variant=0){
  const y=ground(x,z),w=(1.58+variant*.08)*s,d=(1.15+(variant%2)*.17)*s,h=(1.28+(variant%3)*.10)*s;
  const wall=['#c9a77d','#b99571','#d0b58f','#b78e6e'][tone%4],trim=['#604a38','#70513d','#594536'][tone%3];
  box([x,y+h*.49,z],[w,h,d],wall,a,1);
  // true pitched miniature roof with layered eave
  hip('machiya-roof-'+areaHouseId,x,z,w*1.18,d*1.18,y+h*.93,.52*s,.26,variant%2?'#75675e':'#817168');
  plate([x,y+h*.26,z],[w*.92,.055,d+.04*s],trim,a,1);
  // front lattice / shop facade
  for(let j=-3;j<=3;j++){
   const xx=j*w*.115;
   plate([x+Math.cos(a)*xx,y+h*.47,z-Math.sin(a)*xx],[.032*s,.78*s,d+.055*s],trim,a,1);
  }
  for(let j=0;j<3;j++)plate([x,y+h*(.26+j*.22),z],[w*.92,.028*s,d+.06*s],trim,a,1);
  // noren / small shop sign
  if(variant%2===0){
   plate([x+Math.cos(a)*w*.24,y+h*.36,z-Math.sin(a)*w*.24],[w*.33,.32*s,d+.08*s],variant%4===0?'#9d6654':'#718b82',a,1);
  }
  // entrance stone and planter
  plate([x+Math.sin(a)*(d*.55),y+.04,z+Math.cos(a)*(d*.55)],[.48*s,.08,.36*s],'#bdb7a7',a,3);
  ball([x+Math.sin(a)*(d*.67)+Math.cos(a)*w*.32,y+.23,z+Math.cos(a)*(d*.67)-Math.sin(a)*w*.32],[.18*s,.24*s,.18*s],pick(C.greens),tiny,4);
  areaHouseId++;
 }
 function ribbonBuildings(pts,spacing=2.25){
  for(let n=0;n<pts.length-1;n++){
   const a=pts[n],b=pts[n+1],dx=b[0]-a[0],dz=b[1]-a[1],len=Math.hypot(dx,dz),ang=Math.atan2(dx,dz),nx=-dz/len,nz=dx/len;
   const count=Math.max(1,Math.floor(len/spacing));
   for(let k=0;k<count;k++){
    const t=(k+.55)/count,cx=a[0]+dx*t,cz=a[1]+dz*t;
    for(const side of[-1,1]){
     if(rnd()<.11)continue;
     const off=2.02+range(.08,.62),x=cx+nx*off*side,z=cz+nz*off*side;
     if(Math.hypot(x-areaAnchor.hokanji[0],z-areaAnchor.hokanji[1])<3.5||Math.hypot(x-areaAnchor.kodaiji[0],z-areaAnchor.kodaiji[1])<4.2||Math.hypot(x-areaAnchor.yasaka[0],z-areaAnchor.yasaka[1])<5.0)continue;
     areaMachiya(x,z,ang+range(-.07,.07),range(.82,1.20),n+k+(side>0?1:0),(n*3+k+(side>0?2:0))%4);
    }
   }
  }
 }
 ribbonBuildings(eastSpine,2.28);ribbonBuildings(sannenzaka,1.95);ribbonBuildings(ninenzaka,1.92);ribbonBuildings(gionLink,2.15);
 // Secondary lanes close the gaps between the four anchors so the area reads as one townscape.
 const hokanjiLane=[[areaAnchor.hokanji[0]-7.4,areaAnchor.hokanji[1]+1.2],[areaAnchor.hokanji[0]-3.7,areaAnchor.hokanji[1]+.4],areaAnchor.hokanji,[areaAnchor.hokanji[0]+4.8,areaAnchor.hokanji[1]-1.0]];
 const kodaijiLane=[[areaAnchor.kodaiji[0]-7.0,areaAnchor.kodaiji[1]+1.8],[areaAnchor.kodaiji[0]-3.2,areaAnchor.kodaiji[1]+.5],[areaAnchor.kodaiji[0]+5.7,areaAnchor.kodaiji[1]-.7]];
 const yasakaLane=[[areaAnchor.yasaka[0]-7.0,areaAnchor.yasaka[1]-4.8],[areaAnchor.yasaka[0]-3.5,areaAnchor.yasaka[1]-3.6],[areaAnchor.yasaka[0]+5.8,areaAnchor.yasaka[1]-4.0]];
 for(const [name,pts,w]of[['hokanji-side-lane',hokanjiLane,.78],['kodaiji-side-lane',kodaijiLane,.82],['yasaka-south-lane',yasakaLane,.95]]){areaRoad(name,pts,w,'#ded2bc');ribbonBuildings(pts,1.90);}
 // Small cross lanes make the streetscape a fabric rather than a single ribbon.
 const crossLanes=[[[-12.5,17.6],[-18.6,19.0]],[[-20.0,24.0],[-14.5,25.3]],[[-24.0,33.5],[-17.5,34.8]],[[-32.0,40.4],[-24.0,41.0]]];
 for(let q=0;q<crossLanes.length;q++){areaRoad('cross-lane-'+q,crossLanes[q],.68,'#e0d5bf');ribbonBuildings(crossLanes[q],2.05);}

 function hokanjiPagoda(x,z,s=1){
  const y=ground(x,z),wood='#9a694a',deep='#704a36',roof='#625a57';
  for(let k=0;k<5;k++){
   const bodyW=(2.45-k*.18)*s,levelY=y+.54*s+k*.94*s;
   box([x,levelY,z],[bodyW*.58,.82*s,bodyW*.58],wood,0,1);
   // corner posts and balustrade
   for(const sx of[-1,1])for(const sz of[-1,1])pole([x+sx*bodyW*.23,levelY-.33*s,z+sz*bodyW*.23],[x+sx*bodyW*.23,levelY+.34*s,z+sz*bodyW*.23],.045*s,deep);
   hip('hokanji-roof-'+k,x,z,bodyW*1.26,bodyW*1.26,levelY+.35*s,.40*s,.24,roof);
   plate([x,levelY+.18*s,z],[bodyW*.88,.06*s,bodyW*.88],'#b08863',0,1);
  }
  pole([x,y+5.08*s,z],[x,y+6.12*s,z],.05*s,'#927246');
  for(let k=0;k<5;k++)ball([x,y+(6.18+k*.13)*s,z],[.10*s,.08*s,.10*s],'#c09b50',tiny,1);
  areaStoneWall([x-2.4*s,z-2.1*s],[x+2.3*s,z-2.1*s],.48*s);
 }
 hokanjiPagoda(areaAnchor.hokanji[0],areaAnchor.hokanji[1],1.06);

 function templeCompound(x,z,s=1){
  const y=ground(x,z),wood='#966b4d',roof='#72645c';
  // main hall
  box([x,y+.68*s,z],[4.6*s,1.36*s,2.95*s],wood,0,1);
  hip('kodaiji-main-roof',x,z,5.4*s,3.7*s,y+1.30*s,1.10*s,.30,roof);
  // front veranda and columns
  plate([x,y+.18*s,z+1.75*s],[5.0*s,.18*s,1.2*s],'#b58f65',0,1);
  for(let i=-3;i<=3;i++)pole([x+i*.65*s,y+.20*s,z+1.60*s],[x+i*.65*s,y+1.35*s,z+1.60*s],.05*s,'#76513b');
  // Five front bays with recessed light plaster and dark lattice under the eaves.
  for(let i=-2;i<=2;i++){
   const px=x+i*.82*s;
   plate([px,y+.82*s,z+1.49*s],[.68*s,.88*s,.055*s],i===0?'#d8ccb4':'#e6dcc6',0,1);
   for(let j=-1;j<=1;j++)plate([px+j*.19*s,y+.82*s,z+1.455*s],[.025*s,.86*s,.035*s],'#674a37',0,1);
   plate([px,y+.57*s,z+1.43*s],[.66*s,.025*s,.04*s],'#76523a',0,1);
  }
  // Veranda rail, bracket blocks and small stone lanterns make the hall readable up close.
  for(let i=-4;i<=4;i++){
   const px=x+i*.55*s;
   pole([px,y+.22*s,z+2.05*s],[px,y+.66*s,z+2.05*s],.028*s,'#76513b');
  }
  beam([x-2.35*s,y+.66*s,z+2.05*s],[x+2.35*s,y+.66*s,z+2.05*s],.035*s,'#8b6448');
  for(const side of[-1,1]){
   const lx=x+side*2.9*s,lz=z+2.25*s,ly=ground(lx,lz);
   pole([lx,ly,lz],[lx,ly+.55*s,lz],.035*s,'#858172');
   box([lx,ly+.66*s,lz],[.26*s,.22*s,.26*s],'#b9b4a5',0,3);
   hip('kodaiji-lantern-'+side,lx,lz,.38*s,.38*s,ly+.78*s,.15*s,.18,'#8a8578');
  }
  // smaller side hall
  const sx=x+4.2*s,sz=z-.6*s,sy=ground(sx,sz);
  box([sx,sy+.50*s,sz],[2.5*s,1.0*s,1.85*s],'#a27857',-.08,1);
  hip('kodaiji-side-roof',sx,sz,3.0*s,2.35*s,sy+.95*s,.72*s,.28,'#75655d');
  // Stone garden terrace and pond. A broad pale courtyard gives the precinct visual breathing room.
  plate([x,y+.08*s,z+3.0*s],[8.8*s,.06*s,3.6*s],'#d8cfbd',0,0);
  areaStoneWall([x-4.4*s,z+2.70*s],[x+5.4*s,z+2.70*s],.50*s);
  areaStoneWall([x-4.4*s,z-2.35*s],[x+1.8*s,z-2.35*s],.42*s);
  plate([x+3.2*s,ground(x+3.2*s,z+1.2*s)+.06,z+1.2*s],[4.8*s,.05*s,2.55*s],'#82b8bd',-.12,5);
  for(let r=0;r<10;r++){const aa=r*2.399,rr=(.65+(.08*r))*s,rx=x-1.3*s+Math.cos(aa)*rr,rz=z+3.1*s+Math.sin(aa)*rr,ry=ground(rx,rz);box([rx,ry+.08*s,rz],[.28*s,.16*s,.20*s],r%2?'#bdb7a7':'#aaa698',aa,3);}
  for(let j=0;j<16;j++){
   const a=j*2.399,rr=1.1*s*Math.sqrt((j+.4)/16),px=x+3.2*s+Math.cos(a)*rr,pz=z+1.2*s+Math.sin(a)*rr,py=ground(px,pz);
   ball([px,py+.18*s,pz],[.22*s,.16*s,.22*s],pick(C.greens),tiny,4);
  }
 }
 templeCompound(areaAnchor.kodaiji[0],areaAnchor.kodaiji[1],1.02);

 // Kodaiji precinct: white gravel garden, stepping stones, covered link and pond bridge.
 {
  const x=areaAnchor.kodaiji[0],z=areaAnchor.kodaiji[1],y=ground(x,z);
  plate([x-1.1,y+.095,z+3.45],[6.9,.05,2.55],'#e8e0cf',0,0);
  for(let j=0;j<15;j++){
   const px=x-3.0+j*.42,pz=z+3.25+Math.sin(j*.9)*.26,py=ground(px,pz);
   box([px,py+.07,pz],[.30,.13,.22],j%3===0?'#a9a695':'#bdb8a8',j*.23,3);
  }
  for(let j=0;j<7;j++){
   const px=x-3.5+j*.55,pz=z+1.95,py=ground(px,pz);
   pole([px,py+.02,pz],[px,py+.92,pz],.045,'#78604a');
  }
  // Low hedge frames the garden without hiding the hall.
  for(let j=0;j<18;j++){
   const px=x-4.1+j*.47,pz=z+4.55,py=ground(px,pz);
   ball([px,py+.18,pz],[.22,.18,.25],j%4===0?'#8ca258':'#79924f',tiny,4);
  }
  // A small bridge across the pond makes the garden readable in the isometric view.
  const bx=x+3.15,bz=z+1.20,by=ground(bx,bz)+.22;
  plate([bx,by,bz],[1.05,.09,2.75],'#ae805a',-.10,1);
  for(const side of[-1,1]){
   const xx=bx+side*.57;
   pole([xx,by,bz-1.25],[xx,by+.48,bz-1.25],.035,'#815b42');
   pole([xx,by,bz+1.25],[xx,by+.48,bz+1.25],.035,'#815b42');
   beam([xx,by+.48,bz-1.28],[xx,by+.48,bz+1.28],.035,'#8d6548');
  }
 }
 // Small garden pavilion establishes a second architectural scale inside Kodaiji.
 {
  const x=areaAnchor.kodaiji[0]-4.7,z=areaAnchor.kodaiji[1]+4.2,y=ground(x,z);
  plate([x,y+.16,z],[2.15,.18,1.65],'#ad895f',.12,1);
  for(const sx of[-1,1])for(const sz of[-1,1])pole([x+sx*.78,y+.18,z+sz*.58],[x+sx*.78,y+1.15,z+sz*.58],.055,'#7a573f');
  hip('kodaiji-garden-pavilion',x,z,2.65,2.15,y+1.02,.62,.25,'#71645d');
  for(let i=-2;i<=2;i++)plate([x+i*.28,y+.65,z+.62],[.025,.72,.035],'#6d503b',.12,1);
 }

 function areaTorii(x,z,s=1,a=0){
  const y=ground(x,z),c='#c9573f';
  for(const side of[-1,1])pole([x+Math.cos(a)*side*1.18*s,y,z-Math.sin(a)*side*1.18*s],[x+Math.cos(a)*side*1.18*s,y+2.48*s,z-Math.sin(a)*side*1.18*s],.12*s,c);
  const dx=Math.cos(a)*1.62*s,dz=-Math.sin(a)*1.62*s;
  beam([x-dx,y+2.18*s,z-dz],[x+dx,y+2.18*s,z+dz],.14*s,c,.17*s);
  beam([x-dx*1.10,y+2.60*s,z-dz*1.10],[x+dx*1.10,y+2.60*s,z+dz*1.10],.19*s,c,.20*s);
  for(const side of[-1,1])ball([x+Math.cos(a)*side*1.85*s,y+2.60*s,z-Math.sin(a)*side*1.85*s],[.10*s,.10*s,.10*s],'#d48a64',tiny,1);
 }
 areaTorii(areaAnchor.yasaka[0],areaAnchor.yasaka[1]-3.2,1.08,0);
 const yasakaY=ground(areaAnchor.yasaka[0],areaAnchor.yasaka[1]),yasakaX=areaAnchor.yasaka[0],yasakaZ=areaAnchor.yasaka[1];
 // Yasaka main massing with layered shrine details
 box([yasakaX,yasakaY+.78,yasakaZ],[6.2,1.56,3.8],'#b8553e',0,1);
 hip('yasaka-main-roof',yasakaX,yasakaZ,7.05,4.65,yasakaY+1.50,1.18,.29,'#685d57');
 plate([yasakaX,yasakaY+.17,yasakaZ+2.05],[6.4,.18,1.15],'#c48658',0,1);
 // Bright plaster bays and deep vermilion framing under the main eave.
 for(let i=-3;i<=3;i++){
  const px=yasakaX+i*.80;
  plate([px,yasakaY+.87,yasakaZ+1.88],[.62,.92,.06],i===0?'#ead9b8':'#f0e4cb',0,1);
  pole([px-.34,yasakaY+.25,yasakaZ+1.82],[px-.34,yasakaY+1.48,yasakaZ+1.82],.045,'#b94e38');
  pole([px+.34,yasakaY+.25,yasakaZ+1.82],[px+.34,yasakaY+1.48,yasakaZ+1.82],.045,'#b94e38');
  for(let r=-1;r<=1;r++)plate([px+r*.18,yasakaY+.88,yasakaZ+1.84],[.022,.88,.035],'#7c4c38',0,1);
 }
 // Wide front stair and under-eave lantern row.
 areaSteps([yasakaX,yasakaZ+3.1],[yasakaX,yasakaZ+1.95],4.8,8);
 for(let i=-5;i<=5;i++){
  const px=yasakaX+i*.53;
  pole([px,yasakaY+1.56,yasakaZ+2.06],[px,yasakaY+1.72,yasakaZ+2.06],.018,'#69513f');
  ball([px,yasakaY+1.47,yasakaZ+2.06],[.10,.14,.10],i%3===0?'#d8aa6f':'#ead9b6',tiny,1);
 }
 for(let i=-4;i<=4;i++){
  pole([yasakaX+i*.68,yasakaY+.18,yasakaZ+1.82],[yasakaX+i*.68,yasakaY+1.45,yasakaZ+1.82],.055,'#c46748');
  box([yasakaX+i*.68,yasakaY+1.48,yasakaZ+1.82],[.28,.12,.34],'#a64f3b',0,1);
 }
 // lanterns around forecourt
 for(const side of[-1,1])for(let i=0;i<6;i++){
  const lx=yasakaX+side*(4.0+i*.15),lz=yasakaZ-2.2+i*.82,ly=ground(lx,lz);
  pole([lx,ly,lz],[lx,ly+.78,lz],.035,'#7f6246');
  box([lx,ly+.92,lz],[.24,.30,.24],'#ead9b6',0,1);
  hip('lantern-cap-'+side+'-'+i,lx,lz,.38,.38,ly+1.05,.16,.20,'#6e5f55');
 }
 // secondary gate structure
 const gy=ground(yasakaX,yasakaZ-5.3);
 box([yasakaX,gy+.56,yasakaZ-5.3],[4.0,1.12,1.35],'#bd5a42',0,1);
 hip('yasaka-gate-roof',yasakaX,yasakaZ-5.3,4.8,2.0,gy+1.05,.62,.28,'#6b5e57');

 // Yasaka forecourt: broad approach, flanking shrine halls and denser lantern rhythm.
 {
  const x=yasakaX,z=yasakaZ,y=yasakaY;
  plate([x,y+.085,z-4.0],[9.6,.06,5.1],'#d8cbb4',0,0);
  areaSteps([x,z-7.0],[x,z-4.8],3.4,8);
  for(const side of[-1,1]){
   const px=x+side*5.15,pz=z-.35,py=ground(px,pz);
   box([px,py+.54,pz],[2.5,1.08,2.0],side<0?'#bd5c42':'#b95640',0,1);
   hip('yasaka-wing-'+(side<0?'w':'e'),px,pz,3.05,2.55,py+1.02,.72,.26,'#665b56');
   for(let j=-1;j<=1;j++)pole([px+j*.56,py+.08,pz+1.02],[px+j*.56,py+1.02,pz+1.02],.05,'#c66b4d');
  }
  for(let row=0;row<2;row++)for(let j=-4;j<=4;j++){
   const px=x+j*.90,pz=z-3.0-row*1.05,py=ground(px,pz);
   pole([px,py,pz],[px,py+.68,pz],.028,'#79604a');
   box([px,py+.80,pz],[.20,.26,.20],'#ead7ad',0,1);
   hip('yasaka-court-lantern-'+row+'-'+(j+4),px,pz,.32,.32,py+.91,.13,.18,'#6e625a');
  }
 }


 // Human scale extends through the whole district; tiny figures make streets and forecourts legible.
 for(let n=1;n<eastSpine.length-1;n++){
  const a=eastSpine[n-1],b=eastSpine[n],c=eastSpine[n+1];
  for(let j=0;j<3;j++){
   const t=(j+1)/4,x=b[0]+(c[0]-b[0])*t+range(-.28,.28),z=b[1]+(c[1]-b[1])*t+range(-.25,.25);
   person(x,ground(x,z)+.08,z,range(.46,.58),Math.atan2(c[0]-b[0],c[1]-b[1])+range(-.4,.4));
  }
 }
 for(const [cx,cz,count]of[[areaAnchor.hokanji[0],areaAnchor.hokanji[1]+2.7,8],[areaAnchor.kodaiji[0],areaAnchor.kodaiji[1]+3.2,9],[areaAnchor.yasaka[0],areaAnchor.yasaka[1]-3.9,12]]){
  for(let j=0;j<count;j++){const a=j*2.399,r=.65+Math.sqrt((j+.3)/count)*2.0,x=cx+Math.cos(a)*r,z=cz+Math.sin(a)*r;person(x,ground(x,z)+.08,z,range(.46,.58),a+1.2);}
 }

 // Precinct vegetation forms a frame around landmarks, not a blanket over them.
 for(const [cx,cz,rad,count] of [[-22,18,7.0,24],[-18,29,8.0,28],[-29,44,9.0,30],[-12,22,6.1,22]]){
  for(let j=0;j<count;j++){
   const aa=j*2.399,rr=rad*Math.sqrt((j+.5)/count),x=cx+Math.cos(aa)*rr,z=cz+Math.sin(aa)*rr;
   let roadDistance=99;for(let n=0;n<eastSpine.length-1;n++)roadDistance=Math.min(roadDistance,dseg(x,z,eastSpine[n],eastSpine[n+1]));
   if(landmarkClear(x,z)||roadDistance<1.65)continue;
   if(rnd()<.14)pine(x,z,range(.52,.90));else tree(x,z,range(.58,1.05),rnd()<.28?'pink':rnd()<.07?'cream':'green',j%5?1:0);
  }
 }
 // Additional garden shrubs / stone edges to remove empty gaps
 for(let j=0;j<95;j++){
  const x=range(-34,-8),z=range(12,49);
  if(Math.hypot(x-areaAnchor.hokanji[0],z-areaAnchor.hokanji[1])<2.4||Math.hypot(x-areaAnchor.kodaiji[0],z-areaAnchor.kodaiji[1])<2.9||Math.hypot(x-areaAnchor.yasaka[0],z-areaAnchor.yasaka[1])<3.5)continue;
  if(rnd()<.58)ball([x,ground(x,z)+.17,z],[range(.14,.30),range(.10,.22),range(.14,.30)],pick(C.greens),tiny,4);
 }

 // Foreground hillside tissue closes the large empty lower field in the reviewed area camera.
 // This remains authored visual tissue, not surveyed street geometry.
 const foregroundSpine=[[-5.5,20.0],[.5,22.7],[6.5,26.0],[11.8,30.4],[14.0,35.2]];
 const foregroundCrossA=[[-1.5,27.8],[5.0,30.0],[11.8,31.2]];
 const foregroundCrossB=[[3.8,21.5],[4.8,27.2],[4.2,34.2]];
 areaRoad('foreground-spine',foregroundSpine,.78,'#e3d7c1');ribbonBuildings(foregroundSpine,1.90);
 areaRoad('foreground-cross-a',foregroundCrossA,.66,'#e0d4bd');ribbonBuildings(foregroundCrossA,2.0);
 areaRoad('foreground-cross-b',foregroundCrossB,.62,'#e1d5bf');ribbonBuildings(foregroundCrossB,2.1);
 // Terraced pocket gardens make the foreground read as inhabited hillside rather than a blank lawn.
 for(const [cx,cz,w,d,a] of [[8.7,22.6,4.2,2.4,.08],[10.6,27.0,3.8,2.1,-.08],[7.8,33.1,4.5,2.5,.04],[.8,35.0,4.0,2.2,-.04]]){
  const y=ground(cx,cz);
  plate([cx,y+.055,cz],[w,.05,d],'#d7cfbc',a,0);
  for(let j=0;j<7;j++){
   const aa=j*2.399,rr=.35+Math.sqrt((j+.4)/7)*Math.min(w,d)*.34,x=cx+Math.cos(aa)*rr,z=cz+Math.sin(aa)*rr,yy=ground(x,z),sz=range(.14,.25);
   ball([x,yy+sz*.62,z],[sz*1.32,sz*.82,sz*1.15],j%4===0?'#a9b86f':pick(C.greens),tiny,4);
  }
  areaStoneWall([cx-w*.48,cz+d*.48],[cx+w*.48,cz+d*.48],.34);
  for(let j=-2;j<=2;j++){const px=cx+j*w*.16,pz=cz,py=ground(px,pz);box([px,py+.07,pz],[.27,.13,.20],j%2?'#b8b3a3':'#c4bfb0',j*.17,3);}
 }
 // Small open timber pavilions break the sea of roofs without becoming false landmarks.
 for(const [x,z,a]of[[9.2,24.7,.08],[2.0,33.4,-.10]]){
  const y=ground(x,z);plate([x,y+.13,z],[1.55,.14,1.15],'#b18a61',a,1);
  for(const sx of[-1,1])for(const sz of[-1,1])pole([x+sx*.54,y+.15,z+sz*.38],[x+sx*.54,y+.92,z+sz*.38],.042,'#78563f');
  hip('foreground-pavilion-'+areaHouseId++,x,z,1.95,1.55,y+.84,.48,.24,'#74665e');
 }

 // Western Gion transition fills the open side of the diorama with the same machiya language.
 const gionWest=[[-37.8,28.0],[-39.5,34.5],[-39.0,41.2],[-36.0,47.0],[-32.8,51.2]];
 areaRoad('gion-west-spine',gionWest,1.02,'#dfd3bd');
 ribbonBuildings(gionWest,1.82);
 const gionCross=[
  [[-39.2,32.0],[-31.5,32.8]],
  [[-39.5,37.0],[-31.8,37.5]],
  [[-38.7,42.3],[-31.2,42.5]],
  [[-36.8,47.1],[-29.4,47.0]]
 ];
 for(let q=0;q<gionCross.length;q++){areaRoad('gion-west-cross-'+q,gionCross[q],.70,'#e3d8c4');ribbonBuildings(gionCross[q],1.82);}
 // A quieter southern lane connects the tower district to the wider urban fabric.
 const towerSouth=[[-34.5,13.4],[-31.8,15.0],[-29.2,16.4],areaAnchor.hokanji,[-21.7,17.2]];
 areaRoad('tower-south-lane',towerSouth,.76,'#e0d4bd');ribbonBuildings(towerSouth,1.86);
 // Low detailed infill closes isolated gaps without inventing landmark names.
 const infillBands=[
  {z:24.2,x0:-36.5,x1:-25.5,a:.03},
  {z:27.3,x0:-35.8,x1:-26.0,a:-.04},
  {z:52.0,x0:-36.0,x1:-24.0,a:.02}
 ];
 for(let b=0;b<infillBands.length;b++){
  const g=infillBands[b],count=Math.floor((g.x1-g.x0)/2.15);
  for(let j=0;j<=count;j++){
   const x=g.x0+(g.x1-g.x0)*(j/(count||1)),z=g.z+Math.sin(j*.9+b)*.20;
   if(landmarkClear(x,z))continue;
   areaMachiya(x,z,g.a+range(-.025,.025),range(.82,1.06),b+j,(b+j)%4);
  }
 }
 // Garden-scale planting inside landmark clearings: shrubs and clipped forms, never tall occluding crowns.
 for(const [cx,cz,rad,count] of [[areaAnchor.kodaiji[0],areaAnchor.kodaiji[1],6.5,42],[areaAnchor.yasaka[0],areaAnchor.yasaka[1],7.0,38]]){
  for(let j=0;j<count;j++){
   const aa=j*2.399,rr=rad*Math.sqrt((j+.45)/count),x=cx+Math.cos(aa)*rr,z=cz+Math.sin(aa)*rr;
   if(rr<2.7||dseg(x,z,[cx,cz-7],[cx,cz+7])<1.05)continue;
   const y=ground(x,z),sz=range(.14,.28);
   ball([x,y+sz*.62,z],[sz*1.35,sz*.80,sz*1.18],j%6===0?'#a6b66b':pick(C.greens),tiny,4);
  }
 }
 // Edge screen: low walls, shrubs and a few taller trees conceal the abrupt authored boundary.
 for(let j=0;j<34;j++){
  const t=j/33,x=-43.0+Math.sin(j*.65)*.45,z=18+t*36,y=ground(x,z);
  if(j%3===0){box([x,y+.24,z],[.62,.42,.38],j%2?'#b7b2a2':'#c5c0b0',.04,3);}
  else{const sz=range(.22,.36);ball([x,y+sz*.62,z],[sz*1.2,sz*.9,sz],j%5===0?'#98aa62':pick(C.greens),tiny,4);}
  if(j%8===0)tree(x-.8,z+.3,range(.58,.78),j%16===0?'pink':'green',1);
 }
 // Small figures continue through the west-side streets so the new blocks retain human scale.
 for(const pts of [gionWest,...gionCross,towerSouth]){
  for(let n=0;n<pts.length-1;n++){
   const a=pts[n],b=pts[n+1],dx=b[0]-a[0],dz=b[1]-a[1],len=Math.hypot(dx,dz),count=Math.max(1,Math.floor(len/4.2));
   for(let j=0;j<count;j++){const t=(j+.5)/count,x=a[0]+dx*t+range(-.24,.24),z=a[1]+dz*t+range(-.22,.22);person(x,ground(x,z)+.08,z,range(.44,.56),Math.atan2(dx,dz)+range(-.35,.35));}
  }
 }

 scene.areaQuality='v4.5-foreground-fabric-and-mobile-composition';