 if(storybookMode){
  const referenceAnchors=JSON.parse(JSON.stringify(scene.areaSites.geographicAnchors));
  const westReference=__WEST_REFERENCE__;
  const srcGround=ground,base=2.15,displayScale=1.02,displayScaleEast=.56,northStretch=displayScale/.55;
