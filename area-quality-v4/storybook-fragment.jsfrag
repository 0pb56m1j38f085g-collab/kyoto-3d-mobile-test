  for(const m of scene.meshes){
   for(let t=0;t<m.p.length/9;t++){
    for(const values of[m.p,m.n]){const old=values.slice(t*9,t*9+9);for(let j=0;j<3;j++){const k=[0,2,1][j];values[t*9+j*3]=old[k*3];values[t*9+j*3+1]=old[k*3+1];values[t*9+j*3+2]=-old[k*3+2];}}
    const uv=m.u.slice(t*6,t*6+6);for(let j=0;j<3;j++){const k=[0,2,1][j];m.u[t*6+j*2]=uv[k*2];m.u[t*6+j*2+1]=uv[k*2+1];}
   }
   for(const i of m.instances){i.p[2]=-i.p[2];i.q[0]=-i.q[0];i.q[1]=-i.q[1];if(i.anchor)i.anchor[2]=-i.anchor[2];}
  }
  for(const l of Object.values(layouts))l.at[1]=-l.at[1];
  for(const c of clearings){const z=c.z0;c.z0=-c.z1;c.z1=-z;}
  for(const h of houses){h.z=-h.z;h.yaw=-h.yaw;}
  for(const r of[...lanes,...waterways,...crossings])for(const p of r.points)p[1]=-p[1];
  scene.cartography.coordinateFrame={source:'east +X / north +Z',render:'east +X / up +Y / south +Z',north:[0,0,-1],east:[1,0,0],reflectionApplied:true,initialView:'from south-southwest looking north-northeast; north slightly upper-left and east upper-right'};
  const viewBounds={},pins={};
  for(const [key,l]of Object.entries(layouts)){
   const cs=clearings.filter(c=>layoutFor(c.group)===l),bound={x0:Math.min(...cs.map(c=>c.x0)),x1:Math.max(...cs.map(c=>c.x1)),y0:Math.min(...cs.map(c=>c.y0)),y1:Math.max(...cs.map(c=>c.y1)),z0:Math.min(...cs.map(c=>c.z0)),z1:Math.max(...cs.map(c=>c.z1))};viewBounds[key]=bound;
   const main=cs.find(c=>c.group===({temple:'main-hall',hokanji:'metric-hokanji',yasaka:'metric-yasaka-honden',kodaiji:'metric-kodaiji-hojo'})[key]);pins[key]=[l.at[0],main.y1+.75,l.at[1]];
  }
  const overview=Object.values(viewBounds).flatMap(b=>[b.x0,b.x1].flatMap(x=>[b.y0,b.y1+.9].flatMap(y=>[b.z0,b.z1].map(z=>[x,y,z]))));
  // The initial camera follows the approved east-area composition; distant
  // water remains in the scene without forcing all of it into the opening shot.
  for(const [key,name]of[['street','二寧坂'],['sannenzaka','産寧坂']]){
   const points=lanes.filter(r=>r.name===name).flatMap(r=>r.points),x=points.reduce((s,p)=>s+p[0],0)/points.length,z=points.reduce((s,p)=>s+p[1],0)/points.length,y=storyGround(x,-z);
   pins[key]=[x,y+.65,z];viewBounds[key]={x0:x-2,x1:x+2,y0:y,y1:y+2,z0:z-2,z1:z+2};
  }
  scene.cartography.composition={version:'east-entry-1',hero:'清水寺',foreground:'二寧坂・産寧坂',camera:'south-southwest-to-north-northeast',reference:'approved east-area concept 2026-10-22',coverage:'Current constructed core is Kiyomizu / Ninenzaka / Gion. Okazaki, Ginkakuji and Yamashina are future directional extensions, not completed 3D districts.'};
  scene.cartography.landmarkPins=pins;scene.cartography.framing={bounds:viewBounds,overview};
 }
