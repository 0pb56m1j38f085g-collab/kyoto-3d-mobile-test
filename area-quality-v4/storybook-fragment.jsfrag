  function clippedCell(poly){for(let j=0;j<coarseBoundary.length&&poly.length;j++){
   const a=coarseBoundary[j],b=coarseBoundary[(j+1)%coarseBoundary.length],side=p=>(b[0]-a[0])*(p[1]-a[1])-(b[1]-a[1])*(p[0]-a[0]),next=[];
   for(let k=0;k<poly.length;k++){const p=poly[k],q=poly[(k+1)%poly.length],sp=side(p),sq=side(q);if(sp>=-1e-8)next.push(p);if((sp>=0)!==(sq>=0)){const t=sp/(sp-sq);next.push([p[0]+(q[0]-p[0])*t,p[1]+(q[1]-p[1])*t]);}}poly=next;
  }return poly;}
  const step=.28;
  for(let x=bounds.x0;x<bounds.x1-.001;x+=step)for(let z=bounds.z0;z<bounds.z1-.001;z+=step){
   const xx=Math.min(x+step,bounds.x1),zz=Math.min(z+step,bounds.z1);let poly=[[x,z],[xx,z],[xx,zz],[x,zz]];
   if(!poly.every(p=>islandInside(...p,.01)))poly=clippedCell(poly);
   const pts=poly.map(p=>[p[0],storyGround(...p),p[1]]);
   for(let j=1;j<pts.length-1;j++){const a=pts[0],b=pts[j],c=pts[j+1],surface=(a[1]+b[1]+c[1])/3>base+2.9?hillMini:terrainMini;surface.tri(a,b,c,surfaceNormal(a),surfaceNormal(b),surfaceNormal(c));}
  }
  for(let j=0;j<boundary.length;j++){
   const a=boundary[j],b=boundary[(j+1)%boundary.length],aa=[a[0],storyGround(...a),a[1]],bb=[b[0],storyGround(...b),b[1]];edgeMini.quad(aa,bb,[bb[0],.55,bb[2]],[aa[0],.55,aa[2]]);
  }
  // One continuous soil tint: lighting/normals and woodland communicate relief,
