   if(i.anchor)i.anchor=QGA([(i.anchor[0]-l.source[0])*l.scale+l.at[0],base+(l.lift||0)+(i.anchor[1]-base)*l.scale,(i.anchor[2]-l.source[1])*l.scale+l.at[1]]);
   if(i.anchor&&i.group==='metric-kodaiji-garden'){i.p=QGA(i.p.map((v,k)=>i.anchor[k]+(v-i.anchor[k])*1.45));i.s=QGA(i.s.map(v=>v*1.45));}
