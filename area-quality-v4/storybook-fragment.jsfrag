  const roadIds=new Set(footprintData.roads.map(r=>r.id));
  const townRoads=[...footprintData.roads,...westReference.roads.filter(r=>!roadIds.has(r.id))].filter(r=>!historicIds.has(r.id)&&['residential','unclassified','living_street','pedestrian'].includes(r.highway));
  const inTown=p=>p[0]<-6.4&&p[1]>-4&&p[1]<59&&islandInside(...p,.6);
