  const gardenKeepout=(x,z,pad=0)=>gardenPolygons.some(p=>inGardenPoly(x,z,p)||p.some((a,j)=>dseg(x,z,a,p[(j+1)%p.length])<pad+.1));
  const inClearing=(x,z,pad=0)=>clearings.some(c=>x>c.x0-pad&&x<c.x1+pad&&z>c.z0-pad&&z<c.z1+pad);
  group='storybook-lanes';
  const historicIds=new Set(historicalStreets.map(r=>r.id));
  // Keep the main town lanes, not every short service/entrance footway: those
