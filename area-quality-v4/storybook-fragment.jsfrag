  I(terrainMini,[0,0,0],[1,1,1],'#879568',undefined,0);
  I(hillMini,[0,0,0],[1,1,1],'#879568',undefined,0);
  I(edgeMini,[0,0,0],[1,1,1],'#c6b59b',undefined,3);
  group='storybook-waterways';
  const waterMini=mesh('storybook-river-water'),bankMini=mesh('storybook-river-banks'),rippleMini=mesh('storybook-water-glints');
  for(const r of waterways)for(let j=1;j<r.points.length;j++){
   const a=r.points[j-1],b=r.points[j],dx=b[0]-a[0],dz=b[1]-a[1],len=Math.hypot(dx,dz),n=Math.ceil(len/.25),nx=-dz/len,nz=dx/len;
   for(let k=0;k<n;k++){
    const t=(k+.5)/n,x=a[0]+dx*t,z=a[1]+dz*t;if(!islandInside(x,z,r.width*.55))continue;
    const P=(t,s,y)=>[a[0]+dx*t+nx*s,y,a[1]+dz*t+nz*s];
    waterMini.quad(P(k/n,-r.width/2,base-.45),P(k/n,r.width/2,base-.45),P((k+1)/n,r.width/2,base-.45),P((k+1)/n,-r.width/2,base-.45),[0,1,0]);
    for(const s of[-1,1]){
     const inner=s*r.width/2,outer=s*(r.width/2+.75),mid=P(t,(inner+outer)/2,0);
     if(waterways.some(other=>other!==r&&riverDistance(mid[0],mid[2],other)<other.width/2+.35))continue;
     const B=t=>{const p=P(t,outer,0);p[1]=storyGround(p[0],p[2])+.018;return p;};
     const aa=P(k/n,inner,base-.46),bb=B(k/n),cc=B((k+1)/n),dd=P((k+1)/n,inner,base-.46);let normal=V.unit(V.cross(V.sub(bb,aa),V.sub(cc,aa)));if(normal[1]<0)normal=V.mul(normal,-1);bankMini.quad(aa,bb,cc,dd,normal);
    }
    if(k%9===0){const p=(k%3-1)*r.width*.14;rippleMini.quad(P(k/n,p-.04,base-.435),P(k/n,p+.04,base-.435),P((k+2)/n,p+.04,base-.435),P((k+2)/n,p-.04,base-.435),[0,1,0]);}
   }
  }
  I(waterMini,[0,0,0],[1,1,1],'#72bdc4',undefined,0);I(bankMini,[0,0,0],[1,1,1],'#c5c5b1',undefined,3);I(rippleMini,[0,0,0],[1,1,1],'#b9e0da',undefined,0);
  for(const m of scene.meshes)m.instances=m.instances.filter(i=>{
   if(!i.anchor||!['metric-precinct-landscape','metric-kodaiji-garden'].includes(i.group))return true;
   if(waterKeepout(i.anchor[0],i.anchor[2],.5))return false;
   const dy=storyGround(i.anchor[0],i.anchor[2])-i.anchor[1];i.p[1]=GEOQ(i.p[1]+dy);i.anchor[1]=GEOQ(i.anchor[1]+dy);return true;
  });
  // Actual displayed architecture bounds provide clearings for illustrative houses
