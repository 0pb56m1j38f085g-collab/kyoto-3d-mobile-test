   if(m.name==='metric-yasaka-gravel')return false;
   const l=layoutFor(i.group||'');if(!l)return false;
   const heightScale=i.group.includes('garden')||i.group.includes('landscape')?1:(l.heightEmphasis||1);
   i.p=QGA([(i.p[0]-l.source[0])*l.scale+l.at[0],base+(l.lift||0)+(i.p[1]-base)*l.scale*heightScale,(i.p[2]-l.source[1])*l.scale+l.at[1]]);
   i.s=QGA(i.s.map((v,k)=>v*l.scale*(k===1?heightScale:1)));
