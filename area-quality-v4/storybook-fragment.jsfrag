 // Display cartography: a miniature, NOT a measured ground plan or route graph.
 // Original geographic inputs stay unchanged in area-data. Explicitly separate
 // authored locations/scale from the real-world data used by future routing.
 if(storybookMode){
  const referenceAnchors=JSON.parse(JSON.stringify(scene.areaSites.geographicAnchors));
  const srcGround=ground,base=2.15,displayScale=.55;
  const kCentre=[scene.kiyomizuPlacement.roofCentre[0],scene.kiyomizuPlacement.roofCentre[2]];
  const layouts={
   temple:{source:kCentre,at:[0,-1],scale:2.6},
   hokanji:{source:tower.center,at:tower.center.map(v=>v*displayScale),scale:3.0},
   yasaka:{source:[-29.4,46.6],at:[-16.17,25.63],scale:1.65},
   kodaiji:{source:[-15.8,32.1],at:[-7.5,17.2],scale:1.4}
  };
  function layoutFor(g){if(g==='main-hall')return layouts.temple;if(g==='metric-hokanji')return layouts.hokanji;if(g.startsWith('metric-yasaka')||g==='metric-precinct-landscape')return layouts.yasaka;if(g.startsWith('metric-kodaiji'))return layouts.kodaiji;return null;}
  // Preserve the recognisable main-hall/stage and all thirteen architectural
  // models. Old dense landscape and footprint blocks are intentionally omitted.
  for(const m of scene.meshes)m.instances=m.instances.filter(i=>{
   const l=layoutFor(i.group||'');if(!l)return false;
   i.p=QGA([(i.p[0]-l.source[0])*l.scale+l.at[0],base+(i.p[1]-base)*l.scale,(i.p[2]-l.source[1])*l.scale+l.at[1]]);
   i.s=QGA(i.s.map(v=>v*l.scale));
   if(i.anchor)i.anchor=QGA([(i.anchor[0]-l.source[0])*l.scale+l.at[0],base+(i.anchor[1]-base)*l.scale,(i.anchor[2]-l.source[1])*l.scale+l.at[1]]);
   return true;
  });
  group='storybook-terrain';
  const K=layouts.temple;
  function storyGround(x,z){
   const dx=x-K.at[0],dz=z-K.at[1],fade=1-smooth((Math.hypot(dx/1.2,dz)-4.2)/3.0);
   return base+(srcGround(K.source[0]+dx/K.scale,K.source[1]+dz/K.scale)-base)*K.scale*fade;
  }
  // Rounded, finite diorama edge instead of an empty infinite green plane.
  const bounds={x0:-26,x1:8,z0:-8,z1:32,r:4.5};
  const islandInside=(x,z,pad=0)=>{
   const cx=(bounds.x0+bounds.x1)/2,cz=(bounds.z0+bounds.z1)/2;
   const dx=Math.abs(x-cx)-(bounds.x1-bounds.x0)/2+bounds.r+pad,dz=Math.abs(z-cz)-(bounds.z1-bounds.z0)/2+bounds.r+pad;
   return Math.hypot(Math.max(dx,0),Math.max(dz,0))+Math.min(Math.max(dx,dz),0)<bounds.r;
  };
  const terrainMini=mesh('storybook-soft-ground'),edgeMini=mesh('storybook-diorama-edge');
  const boundary=[];
  for(const [cx,cz,start]of[[bounds.x1-bounds.r,bounds.z1-bounds.r,0],[bounds.x0+bounds.r,bounds.z1-bounds.r,Math.PI/2],[bounds.x0+bounds.r,bounds.z0+bounds.r,Math.PI],[bounds.x1-bounds.r,bounds.z0+bounds.r,Math.PI*1.5]])for(let j=0;j<=12;j++){const a=start+j*Math.PI/24;boundary.push([cx+Math.cos(a)*bounds.r,cz+Math.sin(a)*bounds.r]);}
  // Subdivide the long straight sides too: corner-only fans produce long baked
  // shadow streaks across otherwise flat ground between distant vertex samples.
  const coarseBoundary=boundary.slice();boundary.length=0;
  for(let j=0;j<coarseBoundary.length;j++){const a=coarseBoundary[j],b=coarseBoundary[(j+1)%coarseBoundary.length],n=Math.max(1,Math.ceil(Math.hypot(b[0]-a[0],b[1]-a[1])/.65));for(let k=0;k<n;k++)boundary.push([a[0]+(b[0]-a[0])*k/n,a[1]+(b[1]-a[1])*k/n]);}
  const centre=[-9,base,12],rings=64;
  // Concentric strips meet exactly; no stair-stepped silhouette at the boundary.
  for(let j=0;j<boundary.length;j++)for(let r=0;r<rings;r++){
   const a=boundary[j],b=boundary[(j+1)%boundary.length],P=(p,t)=>{const x=centre[0]+(p[0]-centre[0])*t,z=centre[2]+(p[1]-centre[2])*t;return[x,storyGround(x,z),z];};
   terrainMini.quad(P(a,r/rings),P(b,r/rings),P(b,(r+1)/rings),P(a,(r+1)/rings));
   if(r===rings-1){const aa=P(a,1),bb=P(b,1);edgeMini.quad(aa,bb,[bb[0],.55,bb[2]],[aa[0],.55,aa[2]]);}
  }
  I(terrainMini,[0,0,0],[1,1,1],'#b7c997',undefined,0);
  I(edgeMini,[0,0,0],[1,1,1],'#c6b59b',undefined,3);
  // Actual displayed architecture bounds provide clearings for illustrative houses
  // and crowns. No unrelated generic building is placed through a named temple.
  function world(p,i){const[x,y,z]=p.map((v,k)=>v*i.s[k]),[a,b,c,w]=i.q,tx=2*(b*z-c*y),ty=2*(c*x-a*z),tz=2*(a*y-b*x);return[x+w*tx+b*tz-c*ty+i.p[0],y+w*ty+c*tx-a*tz+i.p[1],z+w*tz+a*ty-b*tx+i.p[2]];}
  const clearings=[];
  for(const m of scene.meshes)for(const i of m.instances){
   if(!layoutFor(i.group||'')||i.group.includes('garden')||i.group.includes('landscape'))continue;
   if(!clearings.some(c=>c.group===i.group))clearings.push({group:i.group,x0:Infinity,x1:-Infinity,z0:Infinity,z1:-Infinity});
   const c=clearings.find(c=>c.group===i.group);for(let k=0;k<m.p.length;k+=3){const p=world(m.p.slice(k,k+3),i);c.x0=Math.min(c.x0,p[0]);c.x1=Math.max(c.x1,p[0]);c.z0=Math.min(c.z0,p[2]);c.z1=Math.max(c.z1,p[2]);}
  }
  const gardenKeepout=(x,z,pad=0)=>x>-12.8-pad&&x<.7+pad&&z>15.1-pad&&z<21.2+pad;
  const inClearing=(x,z,pad=0)=>clearings.some(c=>x>c.x0-pad&&x<c.x1+pad&&z>c.z0-pad&&z<c.z1+pad);
  group='storybook-lanes';
  const lanes=historicalStreets.map(r=>({id:r.id,name:r.name,points:r.points.map(p=>p.map(v=>v*displayScale))}));
  const streetSurface=mesh('storybook-cream-lanes'),streetBorder=mesh('storybook-lane-borders');
  const segments=[];
  for(const road of lanes)for(let j=1;j<road.points.length;j++){
   const a=road.points[j-1],b=road.points[j],dx=b[0]-a[0],dz=b[1]-a[1],len=Math.hypot(dx,dz);if(len<.01)continue;
   segments.push({a,b});const steps=Math.ceil(len/.35),nx=-dz/len,nz=dx/len;
   for(let k=0;k<steps;k++){
    const t=(k+.5)/steps,x=a[0]+dx*t,z=a[1]+dz*t;if(!islandInside(x,z,.45)||inClearing(x,z,.12))continue;
    for(const [m,width,lift]of[[streetBorder,.60,.020],[streetSurface,.48,.025]]){
     const P=(t,s)=>{const x=a[0]+dx*t+nx*s*width/2,z=a[1]+dz*t+nz*s*width/2;return[x,storyGround(x,z)+lift,z];};
     m.quad(P(k/steps,-1),P(k/steps,1),P((k+1)/steps,1),P((k+1)/steps,-1));
    }
   }
  }
  I(streetBorder,[0,0,0],[1,1,1],'#c5b69b',undefined,3);I(streetSurface,[0,0,0],[1,1,1],'#efe2c8',undefined,3);
  const laneDistance=(x,z)=>Math.min(...segments.map(s=>dseg(x,z,s.a,s.b)));
  group='storybook-town';
  const roofMini=mesh('storybook-machiya-roof'),roofEdge=mesh('storybook-machiya-eaves');
  const roofP=(x,t,s)=>[x,.42*(1-t)+.10*t**5,s*.62*t];
  for(const s of[-1,1])for(let j=0;j<8;j++){
   const t=j/8,tt=(j+1)/8;roofMini.quad(roofP(-.62,t,s),roofP(.62,t,s),roofP(.62,tt,s),roofP(-.62,tt,s));
  }
  for(const s of[-1,1])roofEdge.quad([-.62,.1,s*.62],[.62,.1,s*.62],[.62,.04,s*.62],[-.62,.04,s*.62]);
  const houses=[],used=[];
  for(const b of footprintData.buildings){
   if(footprintData.customLandmarkIds.includes(b.id)||b.name||b.footprintArea>2.2)continue;
   const x=b.center[0]*displayScale,z=b.center[1]*displayScale,dist=laneDistance(x,z);
   if(!islandInside(x,z,1.4)||dist<.65||dist>3.4||inClearing(x,z,1.1)||gardenKeepout(x,z,.5)||Math.hypot(x,z+1)<5.4)continue;
   if(used.some(p=>Math.hypot(p[0]-x,p[1]-z)<1.05))continue;
   used.push([x,z]);const h=.52+(b.id%5)*.08,w=.68+(b.id%3)*.13,d=.70+(b.id%4)*.07,y=storyGround(x,z),yaw=-Math.atan2(b.axes.u[1],b.axes.u[0]);
   const plaster=['#f0dfc0','#e4cdb4','#eac4bb','#dbe0c5'][b.id%4],tile=['#788b8a','#758177','#8b8e9a','#839b97'][b.id%4];
   box([x,y+h/2,z],[w,h,d],plaster,yaw,1);
   I(roofMini,[x,y+h-.03,z],[w,Math.min(w,d),d],tile,Q.y(yaw),2);I(roofEdge,[x,y+h-.03,z],[w,Math.min(w,d),d],'#596d69',Q.y(yaw),1);
   const co=Math.cos(yaw),si=Math.sin(yaw),P=(xx,yy,zz)=>[x+co*xx+si*zz,y+yy,z-si*xx+co*zz];
   plate(P(0,h*.34,d*.505),[w*.80,h*.46,.015],'#6d5c4a',yaw,1);
   plate(P(0,h*.76,d*.51),[w*.69,h*.19,.018],'#9aacaa',yaw,1);
   for(let j=-2;j<=2;j++)box(P(j*w*.15,h*.31,d*.523),[.022,h*.43,.025],'#b29975',yaw,1);
   if(b.id%4===0)plate(P(0,h*.57,d*.58),[w*.72,.12,.05],['#d89aa9','#94b9ad','#b6b4cc'][b.id%3],yaw,1);
   houses.push({sourceWay:b.id,x,z,illustrative:true});
   if(houses.length>=280)break;
  }
  group='storybook-groves';const trees=[];
  // Three shared low-poly crowns per tree replace thousands of sub-leaf meshes.
  for(let k=0;k<1600&&trees.length<270;k++){
   const x=-25+range(0,32),z=-7+range(0,38),r=range(.36,.55);
   if(!islandInside(x,z,r+.5)||inClearing(x,z,r+.35)||gardenKeepout(x,z,r)||laneDistance(x,z)<r+.40||used.some(p=>Math.hypot(x-p[0],z-p[1])<r+.8)||trees.some(p=>Math.hypot(x-p.x,z-p.z)<r+p.radius+.15))continue;
   const y=storyGround(x,z),h=range(.80,1.25),pink=k%5===0,c=pink?['#eda9bb','#f2c0cc','#e6a0b2']:['#8eae78','#a4be80','#729b71'];
   pole([x,y,z],[x,y+h*.75,z],.055,'#9b8162',true);
   for(const [dx,dy,dz,s]of[[0,1,0,.83],[-.36,.77,.1,.67],[.35,.72,-.13,.64]])ball([x+dx*r,y+dy*h,z+dz*r],[r*s,h*.36,r*s],c[trees.length%3],tiny,4);
   trees.push({x,z,radius:r,height:h});
  }
  scene.areaBuildings=houses;scene.areaStreets=lanes;
  scene.footprintBuildings=[];
  scene.stats={...scene.stats,trees:trees.length,illustrativeHouses:houses.length,mainHallInstances:2158};
  scene.cartography={mode:'illustrated-miniature',metric:false,displayScale,landmarks:layouts,clearings,trees:trees.length,houses:houses.length,routeGeometry:false,notice:'建物の大きさ・間隔・道幅を調整したイラストマップ。経路・所要時間はこの表示形状から算出しません。',geographicSource:{roads:'area-data/historic-streets.json',buildings:'area-data/gion-footprints.json',metresPerUnit:20,anchors:referenceAnchors},routeStatus:'Not implemented: no verified route or walking-time claim.'};
  scene.areaSites.placementAccuracy='Illustrated display, deliberately not to scale. Original geographic source retained separately; no route-time calculation from display coordinates.';
  scene.areaSites.contextPolicy={authoredMiniature:true,vegetation:'Decorative, including pink blossom accents; not live seasonal conditions.',houses:'Selected source centres with illustrative repeated machiya silhouettes; not individual shop identification.'};
  scene.areaSites.scaleStatus='Display has no uniform geographic scale.';
  scene.areaSites.footprintReference={source:footprintData.source,license:footprintData.license,displayedIndividualFootprints:false};
  scene.modelNotice=scene.cartography.notice;
 }
