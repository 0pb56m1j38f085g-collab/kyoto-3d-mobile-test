   if(!clearings.some(c=>c.group===i.group))clearings.push({group:i.group,x0:Infinity,x1:-Infinity,y0:Infinity,y1:-Infinity,z0:Infinity,z1:-Infinity});
   const c=clearings.find(c=>c.group===i.group);for(let k=0;k<m.p.length;k+=3){const p=world(m.p.slice(k,k+3),i);c.x0=Math.min(c.x0,p[0]);c.x1=Math.max(c.x1,p[0]);c.y0=Math.min(c.y0,p[1]);c.y1=Math.max(c.y1,p[1]);c.z0=Math.min(c.z0,p[2]);c.z1=Math.max(c.z1,p[2]);}
  }
