   if(source.tunnel)continue;let current=null;
   const points=source.points.map(display);
   for(let j=1;j<points.length;j++){const pair=clipSegment(points[j-1],points[j]);if(!pair){current=null;continue;}
    if(!current||Math.hypot(current.points.at(-1)[0]-pair[0][0],current.points.at(-1)[1]-pair[0][1])>.001){current={name:source.name,sourceWay:source.id,width:source.name==='鴨川'?2.2:.5,points:[pair[0]]};waterways.push(current);}current.points.push(pair[1]);
   }
  }
  const riverDistance=(x,z,r)=>Math.min(...r.points.slice(1).map((b,j)=>dseg(x,z,r.points[j],b)));
  const waterKeepout=(x,z,pad=0)=>waterways.some(r=>riverDistance(x,z,r)<r.width/2+pad);
  const mountainRelief=(x,z)=>{
   z/=northStretch;const east=smooth((x+2)/9);
   return east*(11.8*Math.exp(-((x-11)**2/50+(z-2)**2/80))+9.7*Math.exp(-((x-10)**2/45+(z-16)**2/90))+8.3*Math.exp(-((x-8)**2/48+(z-29)**2/60)));
  };
  function storyGround(x,z){
   const dx=x-K.at[0],dz=z-K.at[1],fade=1-smooth((Math.hypot(dx/1.2,dz)-8.0)/3.5);
   const terrace=.65*(1-smooth((Math.abs(x+4.5)-7.4)/1.8))*(1-smooth((Math.abs(z/northStretch-17.2)-3.3)/1.4));
