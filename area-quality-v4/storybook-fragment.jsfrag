  const streetSurface=mesh('storybook-cream-lanes'),streetBorder=mesh('storybook-lane-borders'),pavingJoints=mesh('storybook-stone-paving-joints'),stairRisers=mesh('storybook-historic-stair-risers');
  const segments=[];
