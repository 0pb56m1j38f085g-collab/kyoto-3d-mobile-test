  scene.areaSites.contextPolicy={authoredMiniature:true,vegetation:'Decorative, including pink blossom accents; not live seasonal conditions.',houses:'Source-side parcels with six illustrative machiya types; historic street frontages shift at most 0.65 display units. Not individual shop identification.'};
  scene.areaSites.scaleStatus='Display has no uniform geographic scale.';
  scene.areaSites.footprintReference={source:footprintData.source,license:footprintData.license,displayedIndividualFootprints:false};
  scene.modelNotice=scene.cartography.notice;
  // East / Up / North is a LEFT-handed geographic frame. WebGL's right-handed
  // view otherwise mirrors the map (v4.19). Reflect Z exactly once, including
  // mesh winding, normals, quaternions, anchors and displayed metadata.
  for(const m of scene.meshes){
   for(let t=0;t<m.p.length/9;t++){
    for(const values of[m.p,m.n]){const old=values.slice(t*9,t*9+9);for(let j=0;j<3;j++){const k=[0,2,1][j];values[t*9+j*3]=old[k*3];values[t*9+j*3+1]=old[k*3+1];values[t*9+j*3+2]=-old[k*3+2];}}
    const uv=m.u.slice(t*6,t*6+6);for(let j=0;j<3;j++){const k=[0,2,1][j];m.u[t*6+j*2]=uv[k*2];m.u[t*6+j*2+1]=uv[k*2+1];}
   }
   for(const i of m.instances){i.p[2]=-i.p[2];i.q[0]=-i.q[0];i.q[1]=-i.q[1];if(i.anchor)i.anchor[2]=-i.anchor[2];}
  }
  for(const l of Object.values(layouts))l.at[1]=-l.at[1];
  for(const c of clearings){const z=c.z0;c.z0=-c.z1;c.z1=-z;}
  for(const h of houses){h.z=-h.z;h.yaw=-h.yaw;}
  for(const r of streetConstruction){for(const t of r.treads)for(const k of['a','b','c','d'])t[k][2]=-t[k][2];for(const s of r.samples)s.at[2]=-s.at[2];for(const j of r.joins){j.a[1]=-j.a[1];j.b[1]=-j.b[1];for(const k of['leftA','rightA','leftB','rightB'])j[k][2]=-j[k][2];}}
  for(const r of[...lanes,...waterways,...crossings])for(const p of r.points)p[1]=-p[1];
  scene.cartography.coordinateFrame={source:'east +X / north +Z',render:'east +X / up +Y / south +Z',north:[0,0,-1],east:[1,0,0],reflectionApplied:true,initialView:'from Gojo bridge on the west side toward Kiyomizu; north toward screen-left, stage projects toward screen-right'};
  const viewBounds={},pins={};
  for(const [key,l]of Object.entries(layouts)){
   const cs=clearings.filter(c=>layoutFor(c.group)===l),bound={x0:Math.min(...cs.map(c=>c.x0)),x1:Math.max(...cs.map(c=>c.x1)),y0:Math.min(...cs.map(c=>c.y0)),y1:Math.max(...cs.map(c=>c.y1)),z0:Math.min(...cs.map(c=>c.z0)),z1:Math.max(...cs.map(c=>c.z1))};viewBounds[key]=bound;
   const main=cs.find(c=>c.group===({temple:'main-hall',hokanji:'metric-hokanji',yasaka:'metric-yasaka-honden',kodaiji:'metric-kodaiji-hojo'})[key]);pins[key]=[l.at[0],main.y1+.75,l.at[1]];
  }
  const overview=Object.values(viewBounds).flatMap(b=>[b.x0,b.x1].flatMap(x=>[b.y0,b.y1+.9].flatMap(y=>[b.z0,b.z1].map(z=>[x,y,z]))));
  // The new opening includes the real Gojo crossing and the uphill core.
  // Northern landmarks remain available through directional buttons.
  for(const [key,name]of[['street','二寧坂'],['sannenzaka','産寧坂']]){
   const points=lanes.filter(r=>r.name===name).flatMap(r=>r.points),x=points.reduce((s,p)=>s+p[0],0)/points.length,z=points.reduce((s,p)=>s+p[1],0)/points.length,y=storyGround(x,-z);
   pins[key]=[x,y+.65,z];viewBounds[key]={x0:x-2,x1:x+2,y0:y,y1:y+2,z0:z-2,z1:z+2};
  }
  scene.cartography.composition={version:'river-entry-3',hero:'清水寺',foreground:'鴨川・五条大橋',camera:'Gojo bridge toward Kiyomizu',reference:'User requested river-to-temple view and landmark prominence 2026-10-23',coverage:'Current constructed core is Gojo / Kiyomizu / Ninenzaka / Gion. Okazaki, Ginkakuji and Yamashina are future directional extensions, not completed 3D districts.'};
  const gojo=crossings.find(b=>b.name==='五条大橋'),gojoCentre=gojo.points.reduce((a,p)=>[a[0]+p[0]/gojo.points.length,a[1]+p[1]/gojo.points.length],[0,0]);
  pins.bridge=[gojoCentre[0],base+.65,gojoCentre[1]];
  viewBounds.bridge={x0:gojoCentre[0]-2.1,x1:gojoCentre[0]+2.1,y0:base-.45,y1:base+.6,z0:gojoCentre[1]-.9,z1:gojoCentre[1]+.9};
  scene.cartography.composition.entry={name:gojo.name,sourceWay:gojo.sourceWay,at:pins.bridge,source:'area-data/gojo-entry-reference.json',sourceSha256:gojoReference.inputSha256,streetWays:gojoReference.roads.map(r=>r.id),routing:false};
  scene.cartography.vegetation={version:2,count:trees.length,maxHeight:Math.max(...trees.map(t=>t.height)),averageHeight:trees.reduce((s,t)=>s+t.height,0)/trees.length,landmarkGap:1.65,policy:'Smaller, separated decorative crowns; wider clearings around landmark silhouettes.'};
  const approach=lanes.find(r=>r.id===28514434),entryPoint=p=>[p[0],storyGround(p[0],-p[1])+.1,p[1]];
  scene.cartography.composition.approach={sourceWay:approach.id,name:approach.name,from:entryPoint(approach.points[0]),to:entryPoint(approach.points.at(-1)),purpose:'Composition reference only; not a verified station route.'};
  scene.cartography.composition.buildingRotation=0;
  scene.cartography.landmarkPins=pins;scene.cartography.framing={bounds:viewBounds,overview};
 }
