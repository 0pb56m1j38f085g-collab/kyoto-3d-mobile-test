    Q4(blockWood,D(0,y+h-.009),D(0,y+h),D(1,y+h),D(1,y+h-.009));
    for(let j=0;j<=Math.floor(L/.15);j++){const t=j/Math.max(1,Math.floor(L/.15)),dt=Math.min(.018,.006/L);Q4(blockWood,D(Math.max(0,t-dt),y+.03),D(Math.max(0,t-dt),y+h),D(Math.min(1,t+dt),y+h),D(Math.min(1,t+dt),y+.03));}
   }
