 // Clip source roads to the mapped block and keep their physical width separate from authored roads.
 function clipBlock(a,b){let t0=0,t1=1;const dx=b[0]-a[0],dz=b[1]-a[1];for(const[p,q]of[[-dx,a[0]-fb.minX],[dx,fb.maxX-a[0]],[-dz,a[1]-fb.minZ],[dz,fb.maxZ-a[1]]]){
