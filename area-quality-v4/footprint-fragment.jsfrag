   if(da*dc<0){const t=da/(da-dc);pieces.push([a[0]+(c[0]-a[0])*t,a[1]+(c[1]-a[1])*t]);}pieces.push(c);
   if(rise>0)for(let j=1;j<pieces.length;j++){const a=pieces[j-1],c=pieces[j];if(roofY(a)+roofY(c)>2*(y+h)+1e-8)Q4(plaster,[a[0],y+h,a[1]],[a[0],roofY(a),a[1]],[c[0],roofY(c),c[1]],[c[0],y+h,c[1]]);}
  }
  // Thin tile joints follow the actual clipped roof, including recessed footprint corners.
  if(gable){
   const along=[-axis[1],axis[0]],projections=p.map(q=>q[0]*along[0]+q[1]*along[1]),min=Math.min(...projections),max=Math.max(...projections);
   for(let u=min+.02;u<max;u+=.035){
    const hits=[];for(let i=0;i<p.length;i++){const a=p[i],c=p[(i+1)%p.length],ua=a[0]*along[0]+a[1]*along[1],uc=c[0]*along[0]+c[1]*along[1];if((ua<=u&&uc>u)||(uc<=u&&ua>u)){const t=(u-ua)/(uc-ua);hits.push([a[0]+(c[0]-a[0])*t,a[1]+(c[1]-a[1])*t]);}}
    hits.sort((a,c)=>(a[0]-c[0])*axis[0]+(a[1]-c[1])*axis[1]);
    for(let k=1;k<hits.length;k+=2){const ends=[hits[k-1]],a=hits[k-1],c=hits[k],da=a[0]*axis[0]+a[1]*axis[1]-mid,dc=c[0]*axis[0]+c[1]*axis[1]-mid;if(da*dc<0){const t=da/(da-dc);ends.push([a[0]+(c[0]-a[0])*t,a[1]+(c[1]-a[1])*t]);}ends.push(c);
     for(let j=1;j<ends.length;j++){const A=ends[j-1],B=ends[j],P=(q,s)=>[q[0]+along[0]*s*.0015,roofY(q)+.0015,q[1]+along[1]*s*.0015];Q4(blockTile,P(A,-1),P(A,1),P(B,1),P(B,-1));}
