   if(Math.hypot(e[0][0]-e[1][0],e[0][1]-e[1][1])>.18&&depth<12){const m=[(e[0][0]+e[1][0])/2,(e[0][1]+e[1][1])/2];roofTriangle(e[0],m,e[2],side,depth+1);roofTriangle(m,e[1],e[2],side,depth+1);return;}
   if(Math.abs((c[0]-a[0])*(d[1]-a[1])-(c[1]-a[1])*(d[0]-a[0]))<1e-10)return;
